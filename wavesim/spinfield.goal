package wavesim

import (
	"cogentcore.org/core/math32"
)

//gosl:start

// SpinfieldStates are the state variables for the spinfield model.
type SpinfieldStates CabStates //enums:enum -trim-prefix=Spinfield

const (
	// SpinfieldParticle indicates the type of particle present at this cell.
	// zero indicates no particle.
	SpinfieldParticle SpinfieldStates = SpinfieldStates(CabStatesN) + iota

	// SpinfieldPvelX is the particle velocity (proportion of c, [-1..1]) along X axis
	SpinfieldPvelX

	// SpinfieldPvelY is the particle velocity (proportion of c, [-1..1]) along Y axis
	SpinfieldPvelY

	// SpinfieldPvelZ is the particle velocity (proportion of c, [-1..1]) along Z axis
	SpinfieldPvelZ

	// SpinfieldPESq is the square of the particle energy.
	SpinfieldPESq

	// SpinfieldDist is the 1/r distance propagated from the source particle.
	SpinfieldDist

	// SpinfieldDrive is the coupling strength of particle field to wave fields.
	// Computed from Dist.
	SpinfieldDrive

	// SpinfieldHiggs0a is the Higgs spin complex-valued oscillator, 0a.
	SpinfieldHiggs0a

	// SpinfieldHiggs0b is the Higgs spin complex-valued oscillator, 0b.
	SpinfieldHiggs0b

	// SpinfieldHiggs1a is the Higgs spin complex-valued oscillator, 1a.
	SpinfieldHiggs1a

	// SpinfieldHiggs1b is the Higgs spin complex-valued oscillator, 1b.
	SpinfieldHiggs1b

	// Spinfield0a is the core spin complex-valued oscillator, a.
	Spinfield0a

	// Spinfield0b is the core spin complex-valued oscillator, b.
	Spinfield0b

	// SpinfieldXa is the complex-valued oscillator for velocity
	// along the X asis, a. Phase relative to 0 determines velocity.
	SpinfieldXa

	// SpinfieldXb is the complex-valued oscillator for velocity
	// along the X asis, b. Phase relative to 0 determines velocity.
	SpinfieldXb

	// SpinfieldXa is the complex-valued oscillator for velocity
	// along the Y asis, a. Phase relative to 0 determines velocity.
	SpinfieldYa

	// SpinfieldXb is the complex-valued oscillator for velocity
	// along the Y asis, b. Phase relative to 0 determines velocity.
	SpinfieldYb

	// SpinfieldXa is the complex-valued oscillator for velocity
	// along the Z asis, a. Phase relative to 0 determines velocity.
	SpinfieldZa

	// SpinfieldXb is the complex-valued oscillator for velocity
	// along the Z asis, b. Phase relative to 0 determines velocity.
	SpinfieldZb
)

// SpinfieldKernel is the kernel for computing spinfield model.
// Only supports 3D.
func SpinfieldKernel(i uint32) { //gosl:kernel
	ctx := GetCtx(0)
	var x, y, z int32
	ok := ctx.StateCoords(i, &x, &y, &z)
	if !ok {
		return
	}
	sz := ctx.Size.V()
	cur := ctx.CurState
	prv := ctx.PrevState()
	pposA := State[z, y, x, CabPosA, prv]
	pposB := State[z, y, x, CabPosB, prv]
	pvelA := State[z, y, x, CabVelA, prv]
	pvelB := State[z, y, x, CabVelB, prv]

	csq := Params[0].CSq
	omega0 := Params[0].Omega0
	diff := Params[0].Diff
	decay := Params[0].Decay
	// hbar := Params[0].Hbar
	// hcsq := csq * hbar * hbar
	// mhsq := Params[0].MOverHSq

	particle := State[z, y, x, SpinfieldParticle, prv]

	maxNeigh := NeighMax26(x, y, z, int32(SpinfieldDist), prv)

	s0a := State[z, y, x, Spinfield0a, prv]
	s0b := State[z, y, x, Spinfield0b, prv]
	var dist, drive, d0a, d0b float32
	if particle != 0 {
		dist = 1
		drive = 1
		d0a = s0a
		d0b = s0b
	} else {
		dist = State[z, y, x, SpinfieldDist, prv]
		distF := Laplacian26(x, y, z, int32(SpinfieldDist), prv, dist)
		dist += diff * distF // no velocity

		d0a = NeighValue(maxNeigh, x, y, z, int32(Spinfield0a), prv)
		d0b = NeighValue(maxNeigh, x, y, z, int32(Spinfield0b), prv)
		if dist < 0.001 {
			drive = 0
		} else {
			drive = math32.Pow(decay, 1.0/dist)
		}
	}
	State[z, y, x, SpinfieldDist, cur] = dist
	State[z, y, x, SpinfieldDrive, cur] = drive

	s0a += drive * (d0a - s0a)
	s0b += drive * (d0b - s0b)

	s0a -= omega0 * s0b // everybody update to present tense
	s0b += omega0 * s0a

	State[z, y, x, Spinfield0a, cur] = s0a
	State[z, y, x, Spinfield0b, cur] = s0b

	forceA := Laplacian26(x, y, z, int32(CabPosA), prv, pposA)
	forceB := Laplacian26(x, y, z, int32(CabPosB), prv, pposB)
	forceA += drive * (s0a - pposA)
	forceB += drive * (s0b - pposB)

	velA := pvelA + csq*forceA
	posA := pposA + velA

	velB := pvelB + csq*forceB
	posB := pposB + velB

	// todo: later, based on particle..
	// var grAX, grAY, grAZ, grBX, grBY, grBZ float32
	// Gradient18(x, y, z, int32(CabPosA), prv, &grAX, &grAY, &grAZ)
	// Gradient18(x, y, z, int32(CabPosB), prv, &grBX, &grBY, &grBZ)
	//
	// chg := pposB*pvelA - pposA*pvelB
	//
	// curX := pposA*grBX - pposB*grAX
	// curY := pposA*grBY - pposB*grAY
	// curZ := pposA*grBZ - pposB*grAZ

	State[z, y, x, CabForceA, cur] = forceA
	State[z, y, x, CabVelA, cur] = velA
	State[z, y, x, CabPosA, cur] = posA

	State[z, y, x, CabForceB, cur] = forceB
	State[z, y, x, CabVelB, cur] = velB
	State[z, y, x, CabPosB, cur] = posB

	// State[z, y, x, CabCharge, cur] = chg
	// State[z, y, x, CabCurrentX, cur] = curX
	// State[z, y, x, CabCurrentY, cur] = curY
	// State[z, y, x, CabCurrentZ, cur] = curZ

	// esq := State[z, y, x, SpinfieldPESq, prv]

	// todo: Xb * 0a - Xa * 0b etc
	// pvX := (hoP0*hoVX - hoPX*hoV0)
	// pvY := (hoP0*hoVY - hoPY*hoV0)
	// pvZ := (hoP0*hoVZ - hoPZ*hoV0)

	var pvX, pvY, pvZ float32

	pvSq := pvX*pvX + pvY*pvY + pvZ*pvZ
	lorentz := 1.0 / math32.Sqrt(1.0-(pvSq/csq))
	esq := Params[0].C6M2 / (csq - pvSq)

	State[z, y, x, SpinfieldPvelX, cur] = pvX
	State[z, y, x, SpinfieldPvelY, cur] = pvY
	State[z, y, x, SpinfieldPvelZ, cur] = pvZ
	State[z, y, x, SpinfieldPESq, cur] = esq

	if particle == 0 {
		return
	}
	// todo: is this e factor across all dimensions or only within each individual dimension?
	// Sciaretta21 does only within individual, but that doesn't seem correct.
	// Need to empirically measure in separate particle-only test simulation.
	e := 0.5 * (1.0 + pvSq)
	pXp := 0.5 * (e + pvX)
	pXn := 0.5 * (e - pvX)
	pYp := 0.5 * (e + pvY)
	pYn := 0.5 * (e - pvY)
	pZp := 0.5 * (e + pvZ)
	pZn := 0.5 * (e - pvZ)

	rndX := GetRandomNumber(i, ctx.RandCounter.Counter, 0)
	rndY := GetRandomNumber(i, ctx.RandCounter.Counter, 1)
	rndZ := GetRandomNumber(i, ctx.RandCounter.Counter, 2)

	mvX := int32(0)
	if rndX < pXp && x < sz.X {
		mvX = 1
	} else if rndX < pXp+pXn && x > 1 {
		mvX = -1
	}
	mvY := int32(0)
	if rndY < pYp && y < sz.Y {
		mvY = 1
	} else if rndY < pYp+pYn && y > 1 {
		mvY = -1
	}
	mvZ := int32(0)
	if rndZ < pZp && z < sz.Z {
		mvZ = 1
	} else if rndZ < pZp+pZn && z > 1 {
		mvZ = -1
	}
	if Params[0].ThreeD.IsFalse() || Params[0].Move.IsFalse() {
		mvY = 0
		mvZ = 0
	}
	if Params[0].Move.IsFalse() {
		mvX = 0
	}

	if mvX == 0 && mvY == 0 && mvZ == 0 { // not moving..
		State[z, y, x, SpinfieldParticle, cur] = particle
		SetParticleAt(0, lorentz, esq, math32.Vec3i(x, y, z), math32.Vec3(pvX, pvY, pvZ))
		return
	}

	mx := x + mvX
	my := y + mvY
	mz := z + mvZ

	State[z, y, x, SpinfieldParticle, cur] = 0.0
	State[mz, my, mx, SpinfieldParticle, cur] = particle

	SetParticleAt(0, lorentz, esq, math32.Vec3i(mx, my, mz), math32.Vec3(pvX, pvY, pvZ))
}

//gosl:end

func (ss *Sim) SpinfieldConfig() {
	ParamsShouldDisplay = ParticleDisplay
	ss.StateVars = SpinfieldStatesN
	ss.ViewInit(func(view *View) {
		view.SetVar(SpinfieldParticle, -1)
	})
}

// SpinfieldViewAll configures the View to display Spinfield values
func SpinfieldViewAll(view *View) {
	view.Settings.NPanels = PanelsFour
	view.Settings.Camera = 2
	view.Settings.Height = 0.8
	view.Panels[0].Var = Spinfield0a
	view.Panels[1].Var = SpinfieldDrive
	// view.SetCurPrev(Previous, 1)
	view.Panels[2].Var = CabPosA
	// view.SetCurPrev(Previous, 3)
	view.Panels[3].Var = CabPosB
	view.Settings.TrackParticle = 0
}

func (ss *Sim) SpinfieldStats() {
	ss.AddStat(ss.StatStep())
	ss.AddStat(ss.StatSum(CabCC))
	ss.AddStat(ss.StatSum(CabCharge))
	ss.AddStat(ss.StatParticle(0))
}

// ParticleDisplay determines which Parameters fields to display.
var ParticleDisplay = []string{"Edges", "Energy", "C", "Diff", "Decay", "Hbar", "Mass", "Wavelength", "PacketWidth", "Velocity", "Move"}
