package wavesim

import (
	"cogentcore.org/core/math32"
	"cogentcore.org/lab/gosl/slmath"
)

//gosl:start
//gosl:import "cogentcore.org/lab/gosl/slmath"

// HiggsStates are the state variables for the Higgs Model.
type HiggsStates EMStates //enums:enum -trim-prefix=Higgs

const (
	// HiggsHs0a is the Higgs state 0a
	HiggsHs0a HiggsStates = HiggsStates(EMStatesN) + iota

	// HiggsHs0b is the Higgs state 0b
	HiggsHs0b

	// HiggsHs1a is the Higgs state 1a
	HiggsHs1a

	// HiggsHs1b is the Higgs state 1b
	HiggsHs1b

	// HiggsHs0a is the Higgs vel 0a
	HiggsHv0a

	// HiggsHv0b is the Higgs vel 0b
	HiggsHv0b

	// HiggsHv1a is the Higgs vel 1a
	HiggsHv1a

	// HiggsHv1b is the Higgs vel 1b
	HiggsHv1b

	// HiggsCC is the Higgs complex conjugate
	HiggsCC

	// HiggsV is the Higgs potential as a function of CC
	HiggsV

	// HiggsWp is the W+ weak boson field.
	HiggsWp

	// HiggsWn is the W- weak boson field.
	HiggsWn

	// HiggsZ0 is the Z0 weak neutral boson field.
	HiggsZ0
)

// HiggsKernel is the kernel for computing Higgs model.
// Only supports 3D.
func HiggsKernel(i uint32) { //gosl:kernel
	ctx := GetCtx(0)
	var x, y, z int32
	ok := ctx.StateCoords(i, &x, &y, &z)
	if !ok {
		return
	}
	// sz := ctx.Size.V()
	cur := ctx.CurState
	prv := ctx.PrevState()
	csq := Params[0].CSq
	mhsq := Params[0].MOverHSq
	e2h := Params[0].E2OverH
	// e := Params[0].E
	c := Params[0].C
	ehsq := Params[0].EOverHSq
	em := Params[0].EM.IsTrue()
	mu := Params[0].HiggsMu
	lambda := Params[0].HiggsLambda

	if Params[0].Mass < 0 {
		mhsq = -mhsq
	}

	a0 := State[z, y, x, A0s, prv]
	aX := State[z, y, x, AXs, prv]
	aY := State[z, y, x, AYs, prv]
	aZ := State[z, y, x, AZs, prv]

	aV := math32.Vec3(aX, aY, aZ)
	a0sq := a0 * a0
	aVsq := slmath.LengthSquared3(aV)
	aSqD := ehsq * (a0sq - aVsq)

	hs0a := State[z, y, x, HiggsHs0a, prv]
	hs0b := State[z, y, x, HiggsHs0b, prv]
	// hs1a := State[z, y, x, HiggsHs1a, prv]
	// hs1b := State[z, y, x, HiggsHs1b, prv]

	hv0a := State[z, y, x, HiggsHv0a, prv]
	hv0b := State[z, y, x, HiggsHv0b, prv]
	// hv1a := State[z, y, x, HiggsHv1a, prv]
	// hv1b := State[z, y, x, HiggsHv1b, prv]

	hs0aG := Gradient18(x, y, z, int32(hs0a), prv)
	hs0bG := Gradient18(x, y, z, int32(hs0b), prv)

	cc := hv0a*hv0a + hv0b*hv0b
	hv := mu*mu*cc - lambda*cc*cc

	hs0aF := Laplacian26(x, y, z, int32(HiggsHs0a), prv, hs0a)
	hs0aF -= mhsq * hs0a
	hs0aF *= csq
	hs0aF += hv
	if em {
		vd := hs0bG.Mul(aV)
		hs0aF += e2h*(a0*hv0b+c*(vd.X+vd.Y+vd.Z)) + hs0a*aSqD
	}
	hv0aC := hv0a + hs0aF
	hs0aC := hs0a + hv0aC

	hs0bF := Laplacian26(x, y, z, int32(HiggsHs0b), prv, hs0b)
	hs0bF -= mhsq * hs0b
	hs0bF *= csq
	hs0bF += hv
	if em {
		vd := hs0aG.Mul(aV)
		hs0bF += e2h*(a0*hv0aC+c*(vd.X+vd.Y+vd.Z)) + hs0b*aSqD // note: cur hv0aC
	}
	hv0bC := hv0b + hs0bF
	hs0bC := hs0b + hv0bC

	State[z, y, x, HiggsHs0a, cur] = hs0aC
	State[z, y, x, HiggsHs0b, cur] = hs0bC

	State[z, y, x, HiggsHv0a, cur] = hv0aC
	State[z, y, x, HiggsHv0b, cur] = hv0bC

	State[z, y, x, HiggsCC, cur] = cc
	State[z, y, x, HiggsV, cur] = hv
}

//gosl:end

func (ss *Sim) HiggsConfig() {
	ParamsShouldDisplay = HiggsDisplay
	ss.StateVars = HiggsStatesN
	ss.ViewInit(func(view *View) {
		view.SetVar(HiggsHs0a, -1)
	})
}

// HiggsViewAll configures the View to display Higgs values
func HiggsViewAll(view *View) {
	view.Settings.NPanels = PanelsFour
	view.Settings.Camera = 2
	view.Settings.Height = 0.8
	view.Panels[0].Var = HiggsHs0a
	view.Panels[1].Var = A0s
	// view.SetCurPrev(Previous, 1)
	view.Panels[2].Var = HiggsCC
	// view.SetCurPrev(Previous, 3)
	view.Panels[3].Var = HiggsV
	// view.Settings.TrackParticle = 0
}

func (ss *Sim) HiggsStats() {
	ss.AddStat(ss.StatStep())
	ss.AddStat(ss.StatSum(HiggsCC))
	ss.AddStat(ss.StatSum(HiggsV))
	// ss.AddStat(ss.StatParticle(0))
	// ss.AddStat(ss.StatParticle(0))
}

// HiggsDisplay determines which Parameters fields to display.
var HiggsDisplay = []string{"Edges", "Energy", "C", "Diff", "Decay", "Hbar", "Mass", "Wavelength", "PacketWidth", "Velocity", "Move", "Mu0", "HiggsMu", "HiggsLambda"}
