package wavesim

//gosl:start

// StdStates are the state variables for the Standard Model.
type StdStates EMStates //enums:enum -trim-prefix=Std

const (
	// StdCs0a is the Dirac charge state 0a
	StdCs0a StdStates = StdStates(EMStatesN) + iota

	// StdCs0b is the Dirac charge state 0b
	StdCs0b

	// StdCs1a is the Dirac charge state 1a
	StdCs1a

	// StdCs1b is the Dirac charge state 1b
	StdCs1b

	// StdCs0a is the Dirac charge vel 0a
	StdCv0a

	// StdCv0b is the Dirac charge vel 0b
	StdCv0b

	// StdCv1a is the Dirac charge vel 1a
	StdCv1a

	// StdCv1b is the Dirac charge vel 1b
	StdCv1b

	// StdHs0a is the Higgs state 0a
	StdHs0a

	// StdHs0b is the Higgs state 0b
	StdHs0b

	// StdHs1a is the Higgs state 1a
	StdHs1a

	// StdH1b is the Higgs state 1b
	StdH1b

	// StdHv0a is the Higgs vel 0a
	StdHv0a

	// StdHv0b is the Higgs vel 0b
	StdHv0b

	// StdHv1a is the Higgs vel 1a
	StdHv1a

	// StdH1b is the Higgs vel 1b
	StdHv1b

	// StdWp is the W+ weak boson field.
	StdWp

	// StdWn is the W- weak boson field.
	StdWn

	// StdZ0 is the Z0 weak neutral boson field.
	StdZ0
)

