package wavesim

import "cogentcore.org/core/math32"

//gosl:start

// WaveStates are the state variables for Wave equations.
type WaveStates int32 //enums:enum -trim-prefix=Wave

const (
	// WavePos is the position (height) wave state variable.
	WavePos WaveStates = iota

	// WaveVel is the velocity of wave state variable.
	WaveVel

	// WaveForce is the net force computed from neighbors.
	WaveForce

	// WaveV is an external potential energy factor, that
	// can be used to push waves around.
	WaveV

	// WaveKinetic is the kinetic energy.
	WaveKinetic

	// WavePotential is the potential energy.
	WavePotential

	// WaveEnergy is the total kinetic + potential energy.
	WaveEnergy
)

// WaveKernel is the kernel for computing the Wave equations.
func WaveKernel(i uint32) { //gosl:kernel
	ctx := GetCtx(0)
	var x, y, z int32
	ok := ctx.StateCoords(i, &x, &y, &z)
	if !ok {
		return
	}
	cur := ctx.CurState
	prv := ctx.PrevState()
	ppos := State[z, y, x, WavePos, prv]
	pvel := State[z, y, x, WaveVel, prv]
	vpot := State[z, y, x, WaveV, prv]

	var force float32
	if Params[0].ThreeD.IsTrue() {
		force = Laplacian19(x, y, z, int32(WavePos), prv, ppos)
	} else {
		force = Laplacian1D(x, y, z, int32(WavePos), prv, ppos)
	}
	force += vpot * ppos
	// the ONLY difference: does the Laplacian drive the acceleration, or the
	// velocity? Same term, same coefficient, one derivative apart -- and that
	// is the difference between a wave and diffusion. See Params.Diffusion.
	var vel float32
	if Params[0].Diffusion.IsTrue() {
		vel = Params[0].CSq * force
	} else {
		vel = pvel + Params[0].CSq*force
	}
	pos := ppos + vel

	if Params[0].Energy.IsTrue() {
		midVel := 0.5 * (pvel + vel)
		kinetic := Params[0].Inv2CSq * midVel * midVel
		var potential float32
		if Params[0].ThreeD.IsTrue() {
			potential = PotentialEnergy19(x, y, z, int32(WavePos), prv, ppos)
		} else {
			potential = PotentialEnergy1D(x, y, z, int32(WavePos), prv, ppos)
		}

		State[z, y, x, WaveKinetic, cur] = kinetic
		State[z, y, x, WavePotential, cur] = potential
		State[z, y, x, WaveEnergy, cur] = kinetic + potential
	}
	State[z, y, x, WaveForce, cur] = force
	State[z, y, x, WaveVel, cur] = vel
	State[z, y, x, WavePos, cur] = pos
}

// WaveDampKernel is the kernel for computing the Wave equations
// at damped edges. Does Sommerfield damping where velocity = force.
func WaveDampKernel(i uint32) { //gosl:kernel
	ctx := GetCtx(0)
	var x, y, z int32
	face := ctx.EdgeCoords(i, &x, &y, &z)
	if face < 0 {
		return
	}
	sz := ctx.SizePlus1() // exclude updating on edges
	cur := ctx.CurState
	prv := ctx.PrevState()
	ppos := State[z, y, x, WavePos, prv]
	var force float32
	if Params[0].ThreeD.IsTrue() {
		force = LaplacianEdge19(x, y, z, sz.X, sz.Y, sz.Z, int32(WavePos), prv, ppos)
	} else {
		force = LaplacianEdge1D(x, y, z, sz.X, sz.Y, sz.Z, int32(WavePos), prv, ppos)
	}
	vel := Params[0].CSq * force // key damp: no +=
	pos := ppos + vel

	State[z, y, x, WaveForce, cur] = force
	State[z, y, x, WaveVel, cur] = vel
	State[z, y, x, WavePos, cur] = pos
}

//gosl:end

func (ws WaveStates) SetVarSettings(vs *VarSettings) {
	// todo: can set per variable here
}

func (ss *Sim) WaveConfig() {
	ParamsShouldDisplay = WaveParamFields
	ConfigShouldDisplay = WaveConfigFields
	ss.StateVars = WaveStatesN
	ss.initFuncs = WaveConfigs
	ss.SetCurrentInitFunc(0)
	ss.WaveStats()
	ss.Params.Update()
	ss.eqViewInitFunc = WaveViewAll
}

// WaveViewAll configures the View to display Pos and Vel, Cur and Prev
func WaveViewAll(view *View) {
	view.Panels[0].Var = WavePos
	view.Panels[1].Var = WavePos
	view.SetCurPrev(Previous, 1)
	view.Panels[2].Var = WaveVel
	view.Panels[3].Var = WaveVel
	view.SetCurPrev(Previous, 3)
}

var (
	// WaveParamFields determines which Parameters fields to display.
	WaveParamFields = []string{"Edges", "Energy", "C", "Diffusion", "VPotential", "Wavelength", "PacketWidth", "Amplitude"}

	// WaveConfigFields determines which additional Config fields to display.
	WaveConfigFields = []string{"Wavelength", "PacketWidth", "Amplitude"}
)

func (ss *Sim) WaveStats() {
	ss.AddStat(ss.StatStep())
	ss.AddStat(ss.StatSum(WaveKinetic))
	ss.AddStat(ss.StatSum(WavePotential))
	ss.AddStat(ss.StatSum(WaveEnergy))
	// a massless packet: should sit at c, up to the lattice cos(k/2)
	ss.AddStat(ss.StatGroupVel(math32.X, WavePos))
	// across the travel: diffraction alone, and zero for a slab
	ss.AddStat(ss.StatWidth(math32.Z, WavePos))
}

//////// configurations

// WavePacket and WavePulse are shared by Wave and KleinGordon, which use the
// same state variables. That sharing is the point: pick the same config under
// each equation and the ONLY difference is the mass term.
//
// [Sim.MovingWavePacketConfig] gets the initial velocity from
// [Sim.PacketFreq], which already knows whether the equation has a mass, so
// the same call gives a genuine travelling packet either way.
var WaveConfigs = []InitFunc{
	InitFunc{Name: "Wave Packet", Doc: "A travelling packet of one wavelength: run it under Wave and under KleinGordon to see what the mass term costs. In 3D explore the effects of PacketSlab", Func: WavePacket, Current: true},
	InitFunc{Name: "Wave Pulse", Doc: "A bare bump with no velocity: it splits in half, one going each way, because the second-order operator contains both directions", Func: WavePulse},
	InitFunc{Name: "Symmetric Packet ", Doc: "A symmetric packet of one wavelength, without any velocity terms, so the wave goes in both directions, which is good for seeing the superposition effects.", Func: SymmetricPacket},
	InitFunc{Name: "Oscillator", Doc: "A wave sloshing around in a harmonic well, held by an external  potential", Func: WaveOscillator},
}

// WavePacket is a travelling wave packet along X.
//
// Under Wave it moves at c at every wavelength, up to the lattice. Under
// KleinGordon it does not: the mass term makes the equation DISPERSIVE, and
// long waves are the ones it slows. See TestWaveDispersion.
func WavePacket(ss *Sim) {
	ss.MovingWavePacketConfig(WavePos, WaveVel, math32.X, math32.Vec3(-1, -1, -1), 1, 0, 1)
}

// WavePulse is a bare gaussian bump with no velocity anywhere, and the one to
// run against WaveCPulse and WaveCDirPulse.
//
// It splits in half, one going each way at c, because a second-order operator
// contains both directions and nothing in the bump chose between them. Written
// to both time levels, which is what "no velocity" means in a leapfrog.
func WavePulse(ss *Sim) {
	ss.PacketEnv(WavePos, Both, math32.X, math32.Vec3(-1, -1, -1), ss.Config.PacketWidth, ss.Config.Amplitude)
}

// SymmetricPacket is a wave packet along X with no velocity, so it splits and
// moves in both directions symmetrically. Good for visualizing superposition.
func SymmetricPacket(ss *Sim) {
	ss.PosWavePacketConfig(WavePos, math32.X, math32.Vec3(-1, -1, -1), 1, 0, 1)
}

// WaveVMax is the largest |WaveV| the leapfrog can carry. The kernel
// applies c^2 (Laplacian + V) as an acceleration, and a leapfrog holds
// while that coefficient stays under 4 -- of which Laplacian19Radius is spent.
func (ss *Sim) WaveVMax() float32 {
	p := ss.Params
	return 4/p.CSq - Laplacian19Radius
}

// WaveOscillator is HarmonicOscillator for the basic wave equation: a
// wave state swinging in a harmonic well.
func WaveOscillator(ss *Sim) {
	p := ss.Params
	p.Mass = BoundStateMass
	p.Edges = EdgesDamp
	p.Update()
	om := 2 * math32.Pi / ss.Config.OscillatorPeriod
	w := math32.Sqrt(1.0 / om) // ground state width
	d := 2 * w
	ph := ss.HarmonicWell(WaveV, om, d, ss.WaveVMax())
	ctr := math32.Vec3(-1, -1, -1)
	ctr.X = float32(ss.Config.Size.X)*0.5 + d
	ss.Gauss(WavePos, Both, ctr, w, ss.Config.Amplitude, 0)
	ss.ChargedBound(1, ph)
}
