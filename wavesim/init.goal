}

// ParticleAtConfig is a version of ParticleAt that sets Velocity from [Config]
func (ss *Sim) ParticleAtConfig(c math32.Vector3i, partType float32) {
	ss.ParticleAt(c, ss.Config.Velocity, partType)
}

// ParticleField sets field parameters for particle at given position.
func (ss *Sim) ParticleField(c math32.Vector3i, width float32) {
	cf := CoordToFloat(c)
	ss.InvR(SpinfieldDist, cf, 1)
	ss.InvRDrive(SpinfieldDrive, cf, Params[0].Decay)
	ss.InvR(CabAs, cf, 1)
	// ss.InvR(CabBs, cf, 0)
}
