package wavesim

import (
	// "fmt"
	
	"cogentcore.org/core/math32"
	"cogentcore.org/lab/gosl/slrand"
	"cogentcore.org/lab/tensor"
)

func (ss *Sim) ConfigVars() {
	Params = make([]Parameters, 1)
	Params[0].Defaults()
	ss.Params = &Params[0]
	ss.Units.Defaults()
	Ctx = make([]Context, 1)
	Ctx[0].Init()
	NeighWts = tensor.NewFloat32(int(NeighWeightsN), 27)
	NeighOffs = tensor.NewInt32(26,3)
	// NeighOffs is ordered by SHELL: faces first (indices 0-5), then edges
	// (6-17), then corners (18-25). That ordering is what lets the Laplacian
	// stop at NLapNeigh = 18 and never read the corners at all.
	//
	// Laplacian weights, face : edge : corner = 2 : 1 : 0 -- the 19-point
	// stencil. Two conditions pin these down. Normalization
	//	sum_j w_j dx_j^2 = 2
	// makes the stencil exact on quadratics. Isotropy of the leading
	// (4th-order) error additionally needs
	//	sum_j w_j dx^4 == 3 sum_j w_j dx^2 dy^2
	// The intuitive 1/d^2 weighting over all 26 neighbors normalizes correctly
	// but leaves that ratio at 1.615, giving ~36x more directional spread in
	// the wave dispersion (1.97% vs 0.055% at |k| = 0.8). The 18 face+edge
	// neighbors at 2:1 land EXACTLY on the isotropy condition: the 19-point
	// stencil of O'Reilly & Beck (2006) is already isotropic, and extending
	// 1/d^2 out to the corners is precisely what breaks it.
	//
	// The trade: spectral radius rises from 4 to 16/3, so the CFL limit
	// tightens from C < 1 to C < sqrt(3)/2 = 0.866 -- isotropy costs ~13% of
	// the timestep. Adding the corners back with any isotropic weighting buys
	// nothing: same spectral radius, same directional spread.
	lapWt := [4]float32{0, 1.0 / 3.0, 1.0 / 6.0, 0}
	idx := 0
	for shell := 1; shell <= 3; shell++ {
		for z := -1; z <= 1; z++ {
			for y := -1; y <= 1; y++ {
				for x := -1; x <= 1; x++ {
					d2 := x*x + y*y + z*z
					if d2 != shell {
						continue
					}
					NeighOffs[idx, math32.X] = int32(x)
					NeighOffs[idx, math32.Y] = int32(y)
					NeighOffs[idx, math32.Z] = int32(z)
					NeighWts[LaplacianWts, idx] = lapWt[shell]
					NeighWts[AverageWts, idx] = 1.0 / math32.Sqrt(float32(d2))
					idx++
				}
			}
		}
	}
	NeighWts[AverageWts, idx] = 1.0
	// sum += 1.0
	// fmt.Println("sum:", sum, "oneo:", 1.0 / sum)
	
	// Gradient / divergence / curl. Each of the 9 entries is an antipodal PAIR
	// (minus at -1 along the axis, plus at its exact negation), which is what
	// makes every even-order error term cancel and the stencil 2nd order.
	//
	// Weights face : edge : corner = 2 : 1 : 0, ordered by shell so the loops
	// stop at NGradPair = 5 pairs (10 points) instead of 9 (18 points). Every
	// pair sits at x = +-1, so sum_j w_j is pinned by the normalization below
	// and the MAGNITUDE error is identical for any ratios; only the isotropy
	// can be tuned. Isotropy of the leading 3rd-order error needs
	//	T111 == 3*T122,  i.e.  face = 2*edge + 8*corner
	// The intuitive 1/d weighting satisfies the normalization but overshoots
	// that by 82%, giving ~26x more directional spread (5.04% vs 0.16% at
	// |k| = 0.8). Dropping the corner pairs is both cheaper AND slightly more
	// isotropic than keeping them at 16:4:1.
	FaceOffs = tensor.NewInt32(3, 2, 9, 3)
	grdWt := [3]float32{2, 1, 0}
	// transverse offsets for the 9 pairs, in shell order: the face pair, then
	// the 4 edge pairs, then the 4 zero-weight corner pairs.
	var tra [9][2]int32
	ti := 0
	for shell := 0; shell <= 2; shell++ {
		for b := -1; b <= 1; b++ {
			for a := -1; a <= 1; a++ {
				if a*a+b*b != shell {
					continue
				}
				tra[ti][0], tra[ti][1] = int32(a), int32(b)
				ti++
			}
		}
	}
	setPair := func(dim math32.Dims, j int32, mx, my, mz int32) {
		FaceOffs[dim, Minus1, j, math32.X] = mx
		FaceOffs[dim, Minus1, j, math32.Y] = my
		FaceOffs[dim, Minus1, j, math32.Z] = mz
		FaceOffs[dim, Plus1, j, math32.X] = -mx
		FaceOffs[dim, Plus1, j, math32.Y] = -my
		FaceOffs[dim, Plus1, j, math32.Z] = -mz
	}
	sum := float32(0)
	for j := range 9 {
		a, b := tra[j][0], tra[j][1]
		w := grdWt[a*a+b*b]
		NeighWts[Grad10Wts, j] = w
		sum += w
		setPair(math32.X, int32(j), -1, a, b)
		setPair(math32.Y, int32(j), a, -1, b)
		setPair(math32.Z, int32(j), a, b, -1)
	}
	sum *= 2
	for j := range 9 {
		NeighWts[Grad10Wts, j] /= sum
	}
}

//gosl:start

// MinusPlusOne is minus1 and plus1
type MinusPlusOne int32 //enums:enum

const (
	Minus1 MinusPlusOne = iota
	Plus1
)

// NeighWeights
type NeighWeights int32 //enums:enum

const (
	// NNeigh is the full 26-neighborhood in NeighOffs, ordered by shell:
	// faces 0-5, edges 6-17, corners 18-25.
	NNeigh = 26

	// NLapNeigh is how many of those the Laplacian sums over. The isotropic
	// weights are ZERO on the 8 corners, so the loop stops at 18 and never
	// reads them -- the 19-point stencil. Operators that genuinely need all 26
	// (NeighAverage27, NeighMax26) still use NNeigh.
	NLapNeigh = 18

	// NGradPair is how many antipodal PAIRS the gradient, divergence and curl
	// sum over, out of the 9 in FaceOffs. Same story: the 4 corner pairs carry
	// zero weight, so 5 pairs = 10 points instead of 18.
	NGradPair = 5
)

const (
	// LaplacianWts are weighting factors for 3D Laplacian = 3 / (13 * d^2)
	LaplacianWts NeighWeights = iota

	// AverageWts are 26 + 1 ctr average weights = 1 / d
	AverageWts 

	// Grad10Wts are the gradient pair weights, shared by the gradient,
	// divergence and curl. Only the first NGradPair = 5 are non-zero.
	Grad10Wts 
)

const (
	// Average27Sum is the sum of the AverageWts 
	Average27Sum = float32(20.104084)

	// OneoAverage27Sum is 1.0/ sum of the AverageWts, for actual averaging
	OneoAverage27Sum = 0.049741138
)

// Laplacian1D computes the 1D Laplacian across 2 X dim neighbors,
// for given x,y,z center coordinates, variable index vidx,
// and cur / prev time index tidx. ctr is the center value.
func Laplacian1D(x, y, z, vidx, tidx int32, ctr float32) float32 {
	m1 := State[z, y, x-1, vidx, tidx]
	p1 := State[z, y, x+1, vidx, tidx]
	return (m1 + p1) - 2 * ctr
}

// Laplacian19 computes the 3D Laplacian over the 18 face and edge neighbors
// plus the center (the 19-point stencil),
// for given x,y,z center coordinates, variable index vidx,
// and cur / prev time index tidx. ctr is the center value.
func Laplacian19(x, y, z, vidx, tidx int32, ctr float32) float32 {
	avg := float32(0)
	for j := range NLapNeigh {
		xo := NeighOffs[j, math32.X]
		yo := NeighOffs[j, math32.Y]
		zo := NeighOffs[j, math32.Z]
		nv := State[z+zo, y+yo, x+xo, vidx, tidx]
		avg += NeighWts[LaplacianWts, j] * (nv - ctr)
	}
	return avg
}

// NeighAverage27 computes the 3D average across 27 neighbors,
// including the center, for given x,y,z center coordinates, variable index vidx,
// and cur / prev time index tidx. ctr is the center value.
func NeighAverage27(x, y, z, vidx, tidx int32) float32 {
	avg := float32(0)
	for j := range NNeigh {
		xo := NeighOffs[j, math32.X]
		yo := NeighOffs[j, math32.Y]
		zo := NeighOffs[j, math32.Z]
		nv := State[z+zo, y+yo, x+xo, vidx, tidx]
		avg += NeighWts[AverageWts, j] * nv
	}
	avg += NeighWts[AverageWts, 26] * State[z, y, x, vidx, tidx]
	return avg
}

// NeighMax26 returns which neighbor cell index (into NeighOffs offsets)
// has the largest value among the 26 3D neighbors.
// for given x,y,z center coordinates, variable index vidx,
// and cur / prev time index tidx.
func NeighMax26(x, y, z, vidx, tidx int32) int32 {
	mx := float32(0)
	mxi := int32(0)
	for j := range NNeigh {
		xo := NeighOffs[j, math32.X]
		yo := NeighOffs[j, math32.Y]
		zo := NeighOffs[j, math32.Z]
		nv := State[z+zo, y+yo, x+xo, vidx, tidx]
		if nv > mx {
			mx = nv
			mxi = int32(j)
		}
	}
	return mxi
}

// NeighValue returns value at given neighbor cell index
// (into NeighOffs offsets), for given x,y,z center coordinates,
// variable index vidx, and cur / prev time index tidx.
func NeighValue(nidx, x, y, z, vidx, tidx int32) float32 {
	xo := NeighOffs[nidx, math32.X]
	yo := NeighOffs[nidx, math32.Y]
	zo := NeighOffs[nidx, math32.Z]
	nv := State[z+zo, y+yo, x+xo, vidx, tidx]
	return nv
}

// Gradient10 computes the 3D gradient from 5 antipodal pairs (10 points),
// for given x,y,z center coordinates, variable index vidx,
// and cur / prev time index tidx.
func Gradient10(x, y, z, vidx, tidx int32) math32.Vector3 {
	var g math32.Vector3
	for xyz := range 3 {
		sum := float32(0)
		for j := range NGradPair {
			xp := FaceOffs[xyz, Plus1, j, math32.X]
			xm := FaceOffs[xyz, Minus1, j, math32.X]
			yp := FaceOffs[xyz, Plus1, j, math32.Y]
			ym := FaceOffs[xyz, Minus1, j, math32.Y]
			zp := FaceOffs[xyz, Plus1, j, math32.Z]
			zm := FaceOffs[xyz, Minus1, j, math32.Z]
			grad := NeighWts[Grad10Wts, j] * (State[z+zp, y+yp, x+xp, vidx, tidx] - State[z+zm, y+ym, x+xm, vidx, tidx])
			sum += grad
		}
		switch xyz {
		case 0:
			g.X = sum
		case 1:
			g.Y = sum
		case 2:
			g.Z = sum
		default:
		}
	}
	return g
}

// Divergence10 computes the 3D divergence from 5 antipodal pairs (10 points)
// per direction,
// for given x,y,z center coordinates, variable index vidx,
// and cur / prev time index tidx. Div = sum of gradients.
func Divergence10(x, y, z, vidx, tidx int32, dx, dy, dz *float32) float32 {
	sum := float32(0)
	for xyz := range 3 {
		d := float32(0)
		// component xyz of the vector field lives at vidx+xyz, and is
		// differentiated along direction xyz -- that pairing is what makes this
		// a divergence rather than a sum of derivatives of one scalar.
		vi := vidx + int32(xyz)
		for j := range NGradPair {
			xp := FaceOffs[xyz, Plus1, j, math32.X]
			xm := FaceOffs[xyz, Minus1, j, math32.X]
			yp := FaceOffs[xyz, Plus1, j, math32.Y]
			ym := FaceOffs[xyz, Minus1, j, math32.Y]
			zp := FaceOffs[xyz, Plus1, j, math32.Z]
			zm := FaceOffs[xyz, Minus1, j, math32.Z]
			d += NeighWts[Grad10Wts, j] * (State[z+zp, y+yp, x+xp, vi, tidx] - State[z+zm, y+ym, x+xm, vi, tidx])
		}
		switch xyz {
		case 0:
			*dx = d
		case 1:
			*dy = d
		default:
			*dz = d
		}
		sum += d
	}
	return sum
}

// Curl10 computes the 3D curl from 5 antipodal pairs (10 points) per
// direction, on a field vector,
// for given x,y,z center coordinates, variable index vidx (to X component),
// and cur / prev time index tidx.
func Curl10(x, y, z, vidx, tidx int32) math32.Vector3 {
	var dzdy, dydz, dxdz, dzdx, dydx, dxdy float32
	dimX := vidx + int32(math32.X)
	dimY := vidx + int32(math32.Y)
	dimZ := vidx + int32(math32.Z)
	for j := range NGradPair {
		xpX := FaceOffs[math32.X, Plus1, j, math32.X]
		xmX := FaceOffs[math32.X, Minus1, j, math32.X]
		ypX := FaceOffs[math32.X, Plus1, j, math32.Y]
		ymX := FaceOffs[math32.X, Minus1, j, math32.Y]
		zpX := FaceOffs[math32.X, Plus1, j, math32.Z]
		zmX := FaceOffs[math32.X, Minus1, j, math32.Z]

		xpY := FaceOffs[math32.Y, Plus1, j, math32.X]
		xmY := FaceOffs[math32.Y, Minus1, j, math32.X]
		ypY := FaceOffs[math32.Y, Plus1, j, math32.Y]
		ymY := FaceOffs[math32.Y, Minus1, j, math32.Y]
		zpY := FaceOffs[math32.Y, Plus1, j, math32.Z]
		zmY := FaceOffs[math32.Y, Minus1, j, math32.Z]

		xpZ := FaceOffs[math32.Z, Plus1, j, math32.X]
		xmZ := FaceOffs[math32.Z, Minus1, j, math32.X]
		ypZ := FaceOffs[math32.Z, Plus1, j, math32.Y]
		ymZ := FaceOffs[math32.Z, Minus1, j, math32.Y]
		zpZ := FaceOffs[math32.Z, Plus1, j, math32.Z]
		zmZ := FaceOffs[math32.Z, Minus1, j, math32.Z]
		
		dzdy += NeighWts[Grad10Wts, j] * (State[z+zpY, y+ypY, x+xpY, dimZ, tidx] - State[z+zmY, y+ymY, x+xmY, dimZ, tidx])
		dydz += NeighWts[Grad10Wts, j] * (State[z+zpZ, y+ypZ, x+xpZ, dimY, tidx] - State[z+zmZ, y+ymZ, x+xmZ, dimY, tidx])

		dxdz += NeighWts[Grad10Wts, j] * (State[z+zpZ, y+ypZ, x+xpZ, dimX, tidx] - State[z+zmZ, y+ymZ, x+xmZ, dimX, tidx])
		dzdx += NeighWts[Grad10Wts, j] * (State[z+zpX, y+ypX, x+xpX, dimZ, tidx] - State[z+zmX, y+ymX, x+xmX, dimZ, tidx])
		
		dydx += NeighWts[Grad10Wts, j] * (State[z+zpX, y+ypX, x+xpX, dimY, tidx] - State[z+zmX, y+ymX, x+xmX, dimY, tidx])
		dxdy += NeighWts[Grad10Wts, j] * (State[z+zpY, y+ypY, x+xpY, dimX, tidx] - State[z+zmY, y+ymY, x+xmY, dimX, tidx])
	}
	var c math32.Vector3
	c.X = dzdy - dydz
	c.Y = dxdz - dzdx
	c.Z = dydx - dxdy
	return c
}

//////// Edges

// EdgeInBounds1 returns true if given coordinate is >= 1 and < s.
func EdgeInBounds1(x, y, z, sx, sy, sz int32) bool {
	return x >= 1 && x < sx && y >= 1 && y < sy && z >= 1 && z < sz
}

// EdgeInBounds0 returns true if given coordinate is >= 0 and <= s.
func EdgeInBounds0(x, y, z, sx, sy, sz int32) bool {
	return x >= 0 && x <= sx && y >= 0 && y <= sy && z >= 0 && z <= sz
}

// LaplacianEdge1D computes the 1D Laplacian across 2 X dim neighbors,
// for given x,y,z center coordinates, variable index vidx,
// and cur / prev time index tidx. ctr is the center value.
// For computation at the edge, checks against given full size bounds.
func LaplacianEdge1D(x, y, z, sx, sy, sz, vidx, tidx int32, ctr float32) float32 {
	sum := float32(0)
	if EdgeInBounds1(x-1,y,z, sx, sy, sz) {
		sum += State[z, y, x-1, vidx, tidx] - ctr
	}
	if EdgeInBounds1(x+1,y,z, sx, sy, sz) {
		sum += State[z, y, x+1, vidx, tidx] - ctr
	}
	return sum
}

// LaplacianEdge19 computes the 19-point 3D Laplacian,
// for given x,y,z center coordinates, variable index vidx,
// and cur / prev time index tidx. ctr is the center value.
// For computation at the edge, checks against given full size bounds.
func LaplacianEdge19(x, y, z, sx, sy, sz, vidx, tidx int32, ctr float32) float32 {
	avg := float32(0)
	for j := range NLapNeigh {
		xo := NeighOffs[j, math32.X]
		yo := NeighOffs[j, math32.Y]
		zo := NeighOffs[j, math32.Z]
		if EdgeInBounds1(x+xo, y+yo, z+zo, sx, sy, sz) {
			nv := State[z+zo, y+yo, x+xo, vidx, tidx]
			avg += NeighWts[LaplacianWts, j] * (nv - ctr)
		}
	}
	return avg
}

// PotentialEnergy1D computes the 1D potential energy across 2 neighbors,
// for given x,y,z center coordinates, variable index vidx,
// and cur / prev time index tidx. ctr is the center value.
func PotentialEnergy1D(x, y, z, vidx, tidx int32, ctr float32) float32 {
	m1 := State[z, y, x-1, vidx, tidx]
	p1 := State[z, y, x+1, vidx, tidx]
	pm1d := m1 - ctr
	pp1d := p1 - ctr
	return 0.5 * (pm1d * pm1d + pp1d * pp1d)
}

// PotentialEnergy19 computes the 3D potential energy over the 19-point stencil,
// for given x,y,z center coordinates, variable index vidx,
// and cur / prev time index tidx. ctr is the center value.
func PotentialEnergy19(x, y, z, vidx, tidx int32, ctr float32) float32 {
	avg := float32(0)
	for j := range NLapNeigh {
		xo := NeighOffs[j, math32.X]
		yo := NeighOffs[j, math32.Y]
		zo := NeighOffs[j, math32.Z]
		nv := State[z+zo, y+yo, x+xo, vidx, tidx]
		dv := (nv - ctr)
		avg += NeighWts[LaplacianWts, j] * dv * dv
	}
	return avg
}

// GetRandomNumber returns a random number that depends on the index,
// counter and function index.
// We increment the counter after each cycle, so that we get new random numbers.
// This whole scheme exists to ensure equal results under different multithreading settings.
func GetRandomNumber(index uint32, counter uint64, funIndex uint32) float32 {
	return slrand.Float32(counter, funIndex, index)
}

//gosl:end

