package wavesim

import (
	"cogentcore.org/core/enums"
	"cogentcore.org/core/math32"
)

// InitFunc is used for making a GUI representation of different initialization
// functions that the user can select, which will be run when Init is pressed.
type InitFunc struct {
	// Name of init function.
	Name string

	// Doc provides brief documentation of what it does.
	Doc string

	// Func is the function to call
	Func func(sim *Sim)

	// Current indicates that this is the currently-selected item.
	Current bool
}

// WrapEdges re-wraps the edges. This is called automatically in Init for
// EdgesWrap case.
func WrapEdges() {
	ctx := GetCtx(0)
	RunEdgesWrapKernel(int(ctx.EdgesN()))
}

// CopyCurToPrev copies the current values to previous values
// for all variables.
func (ss *Sim) CopyCurToPrev() {
	ctx := GetCtx(0)
	cur := ctx.CurState
	prv := ctx.PrevState()
	nvars := ctx.NVars
	sz := ss.Config.Size
	var c math32.Vector3i
	for c.Z = range sz.Z {
		for c.Y = range sz.Y {
			for c.X = range sz.X {
				f := c.AddScalar(1)
				for vi := range nvars {
					State[f.Z, f.Y, f.X, vi, prv] = State[f.Z, f.Y, f.X, vi, cur]
				}
			}
		}
	}
}

// CenterI returns the given 3D coords with any negative
// numbers replaced with the value plus center+1 (of non-edge space)
// such that -1 = center, -2 = 1 before center, etc.
func CenterI(c math32.Vector3i) math32.Vector3i {
	ctx := GetCtx(0)
	ctr := ctx.Size.V().DivScalar(2).AddScalar(1)
	if c.X < 0 {
		c.X += ctr.X
	}
	if c.Y < 0 {
		c.Y += ctr.Y
	}
	if c.Z < 0 {
		c.Z += ctr.Z
	}
	return c
}

// CenterF returns the given 3D coords with any negative
// numbers replaced with the value plus center+1 (of non-edge space)
// such that -1 = center, -2 = 1 before center, etc.
func CenterF(c math32.Vector3) math32.Vector3 {
	ctx := GetCtx(0)
	ctr := ctx.Size.V().DivScalar(2).AddScalar(1)
	if c.X < 0 {
		c.X += float32(ctr.X)
	}
	if c.Y < 0 {
		c.Y += float32(ctr.Y)
	}
	if c.Z < 0 {
		c.Z += float32(ctr.Z)
	}
	return c
}

func CoordToFloat(c math32.Vector3i) math32.Vector3 {
	var f math32.Vector3
	f.SetFromVector3i(c)
	return f
}

func CoordToInt(c math32.Vector3) math32.Vector3i {
	var f math32.Vector3i
	f.SetFromVector3(c)
	return f
}

// CenterFull returns the given 3d coords with any negative
// numbers replaced with the value plus center+1 (of full space)
// such that -1 = center, -2 = 1 before center, etc.
func CenterFull(c math32.Vector3i) math32.Vector3i {
	ctx := GetCtx(0)
	ctr := ctx.Size.V().DivScalar(2).AddScalar(2)
	if c.X < 0 {
		c.X += ctr.X
	}
	if c.Y < 0 {
		c.Y += ctr.Y
	}
	if c.Z < 0 {
		c.Z += ctr.Z
	}
	return c
}

// WavePacket returns value for a gaussian * cosine wave packet for given
// linear dimension value x and 3D distance d.
func WavePacket(x, d, wavelength, width, phase, amp float32) float32 {
	cos := amp * math32.Cos(TwoPi*((x/wavelength)+phase))
	d /= width
	gauss := math32.FastExp(-d * d)
	return cos * gauss
}

// Point adds value to individual point, optionally for both cur and previous values.
func (ss *Sim) Point(vr enums.Enum, curPrev CurPrevBoth, c math32.Vector3i, val float32) {
	vri := int(vr.Int64())
	ctx := GetCtx(0)
	cur := ctx.CurState
	prv := ctx.PrevState()
	f := CenterFull(c)
	if curPrev == CurOnly || curPrev == Both {
		State[f.Z, f.Y, f.X, vri, cur] += val
	}
	if curPrev == PrevOnly || curPrev == Both {
		State[f.Z, f.Y, f.X, vri, prv] += val
	}
}

// Fill adds given number to all cells.
func (ss *Sim) Fill(vr enums.Enum, curPrev CurPrevBoth, val float32) {
	vri := int(vr.Int64())
	ctx := GetCtx(0)
	cur := ctx.CurState
	prv := ctx.PrevState()
	sz := ss.Config.Size
	var c math32.Vector3i
	for c.Z = range sz.Z {
		for c.Y = range sz.Y {
			for c.X = range sz.X {
				f := c.AddScalar(1)
				if curPrev == CurOnly || curPrev == Both {
					State[f.Z, f.Y, f.X, vri, cur] += val
				}
				if curPrev == PrevOnly || curPrev == Both {
					State[f.Z, f.Y, f.X, vri, prv] += val
				}
			}
		}
	}
}

// Sine adds sine wave values along given dimension, to given variable.
func (ss *Sim) Sine(vr enums.Enum, dim math32.Dims, wavelength, phase, amp, off float32) {
	vri := int(vr.Int64())
	ctx := GetCtx(0)
	cur := ctx.CurState
	sz := ss.Config.Size
	var c math32.Vector3i
	for c.Z = range sz.Z {
		for c.Y = range sz.Y {
			for c.X = range sz.X {
				f := c.AddScalar(1)
				dv := float32(c.Dim(dim))
				v := off + amp*math32.Sin(TwoPi*((dv+phase)/wavelength))
				State[f.Z, f.Y, f.X, vri, cur] += v
			}
		}
	}
}

// Gauss adds gaussian values to given variable.
func (ss *Sim) Gauss(vr enums.Enum, curPrev CurPrevBoth, ctr math32.Vector3, width, amp, off float32) {
	vri := int(vr.Int64())
	ctx := GetCtx(0)
	ctr = CenterF(ctr)
	cur := ctx.CurState
	prv := ctx.PrevState()
	sz := ss.Config.Size
	var c math32.Vector3i
	for c.Z = range sz.Z {
		for c.Y = range sz.Y {
			for c.X = range sz.X {
				f := c.AddScalar(1)
				ff := CoordToFloat(c)
				d := ff.Sub(ctr).Length() / width
				v := off + amp*math32.FastExp(-d*d)
				if curPrev == CurOnly || curPrev == Both {
					State[f.Z, f.Y, f.X, vri, cur] += v
				}
				if curPrev == PrevOnly || curPrev == Both {
					State[f.Z, f.Y, f.X, vri, prv] += v
				}
			}
		}
	}
}

// Step adds a discrete step to given variable, for positive values along given dimension.
func (ss *Sim) Step(vr enums.Enum, curPrev CurPrevBoth, pos math32.Vector3, dim math32.Dims, amp, off float32) {
	vri := int(vr.Int64())
	ctx := GetCtx(0)
	pos = CenterF(pos)
	cur := ctx.CurState
	prv := ctx.PrevState()
	sz := ss.Config.Size
	var c math32.Vector3i
	for c.Z = range sz.Z {
		for c.Y = range sz.Y {
			for c.X = range sz.X {
				f := c.AddScalar(1)
				ff := CoordToFloat(c)
				d := ff.Sub(pos).Dim(dim)
				v := off
				if d >= 0 {
					v += amp
				}
				if curPrev == CurOnly || curPrev == Both {
					State[f.Z, f.Y, f.X, vri, cur] += v
				}
				if curPrev == PrevOnly || curPrev == Both {
					State[f.Z, f.Y, f.X, vri, prv] += v
				}
			}
		}
	}
}

// PosWavePacket adds a gaussian * cosine wave packet along given dimension,
// with given parameters, to just the current and previous position variables.
// This will produce two moving wave packets that split off into opposite directions.
func (ss *Sim) PosWavePacket(vr enums.Enum, dim math32.Dims, ctr math32.Vector3, dir, wavelength, width, phase, amp float32) {
	vri := int(vr.Int64())
	ctx := GetCtx(0)
	cur := ctx.CurState
	prv := ctx.PrevState()
	ctrf := CenterF(ctr)
	var diroff math32.Vector3
	diroff.SetDim(dim, dir*ss.Params.C)
	sz := ss.Config.Size
	var c math32.Vector3i
	for c.Z = range sz.Z {
		for c.Y = range sz.Y {
			for c.X = range sz.X {
				f := c.AddScalar(1)
				ff := CoordToFloat(c)
				d := ff.Sub(ctrf)
				cv := WavePacket(d.Dim(dim), d.Length(), wavelength, width, phase, amp)
				State[f.Z, f.Y, f.X, vri, cur] += cv

				ff.SetAdd(diroff)
				d = ff.Sub(ctrf)
				pv := WavePacket(d.Dim(dim), d.Length(), wavelength, width, phase, amp)
				State[f.Z, f.Y, f.X, vri, prv] += pv
			}
		}
	}
}

// PosWavePacketConfig is a version of [PosWavePacket] that gets parameters from
// [Config]. amp is relative to [Config.Amplitude].
func (ss *Sim) PosWavePacketConfig(vr enums.Enum, dim math32.Dims, ctr math32.Vector3, dir, phase, amp float32) {
	ss.PosWavePacket(vr, dim, ctr, dir, ss.Config.Wavelength, ss.Config.PacketWidth, phase, ss.Config.Amplitude*amp)
}

// PacketFreq returns the lattice angular frequency for a packet of the given
// wavelength under the equation being simulated: massless for the pure wave
// and electromagnetic cases, the Klein-Gordon dispersion where there is a mass.
func (ss *Sim) PacketFreq(wavelength float32) float32 {
	mass := float32(0)
	switch ss.Config.Equation {
	case KleinGordon, KleinGordonC, Dirac, Spinfield:
		mass = math32.Sqrt(ss.Params.MOverHSq)
	}
	return ss.LatticeFreq(wavelength, mass)
}

// MovingWavePacket adds a gaussian * cosine wave packet along given dimension
// to the position variable, and the time derivative that actually belongs with
// it to the velocity variable, so the packet travels one way.
//
// For psi = env cos(k x + phase - dir w t) the initial time derivative is
// dir w env sin(k x + phase), and a quarter cycle of the carrier turns the
// cosine into the sine, so the velocity is the same packet shifted by -1/4 and
// scaled by dir w. The frequency comes from [Sim.PacketFreq], which is the
// LATTICE dispersion for this equation: using the continuum k instead mistunes
// the packet and leaves a counter-propagating remnant.
//
// A gaussian envelope is a spread of wavenumbers, not one, so a narrow packet
// still disperses and sheds a little backwards -- that is physics, not the
// discretization. Wide packets are clean.
func (ss *Sim) MovingWavePacket(posVar, velVar enums.Enum, dim math32.Dims, ctr math32.Vector3, dir, wavelength, width, phase, amp float32) {
	posI := int(posVar.Int64())
	velI := int(velVar.Int64())
	ctx := GetCtx(0)
	cur := ctx.CurState
	prv := ctx.PrevState()
	om := ss.PacketFreq(wavelength)
	ctrf := CenterF(ctr)
	sz := ss.Config.Size
	var c math32.Vector3i
	for c.Z = range sz.Z {
		for c.Y = range sz.Y {
			for c.X = range sz.X {
				f := c.AddScalar(1)
				d := CoordToFloat(c).Sub(ctrf)
				dd := d.Dim(dim)
				dl := d.Length()
				pv := WavePacket(dd, dl, wavelength, width, phase, amp)
				vv := dir * om * WavePacket(dd, dl, wavelength, width, phase-0.25, amp)
				State[f.Z, f.Y, f.X, posI, cur] += pv
				State[f.Z, f.Y, f.X, posI, prv] += pv
				State[f.Z, f.Y, f.X, velI, cur] += vv
				State[f.Z, f.Y, f.X, velI, prv] += vv
			}
		}
	}
}

// ComplexPacket adds a travelling packet to a FIRST-ORDER complex wave, such
// as Schrodinger's, where the two variables are the real and imaginary parts
// rather than a position and its velocity. Both get the same envelope and
// amplitude, a quarter cycle of the carrier apart, which is what makes
// chi = env e^i(k x) run one way.
func (ss *Sim) ComplexPacket(posA, posB enums.Enum, dim math32.Dims, ctr math32.Vector3, dir, wavelength, width, phase, amp float32) {
	ai := int(posA.Int64())
	bi := int(posB.Int64())
	ctx := GetCtx(0)
	cur := ctx.CurState
	prv := ctx.PrevState()
	ctrf := CenterF(ctr)
	sz := ss.Config.Size
	var c math32.Vector3i
	for c.Z = range sz.Z {
		for c.Y = range sz.Y {
			for c.X = range sz.X {
				f := c.AddScalar(1)
				d := CoordToFloat(c).Sub(ctrf)
				dd := d.Dim(dim)
				dl := d.Length()
				av := WavePacket(dd, dl, wavelength, width, phase, amp)
				bv := dir * WavePacket(dd, dl, wavelength, width, phase-0.25, amp)
				State[f.Z, f.Y, f.X, ai, cur] += av
				State[f.Z, f.Y, f.X, ai, prv] += av
				State[f.Z, f.Y, f.X, bi, cur] += bv
				State[f.Z, f.Y, f.X, bi, prv] += bv
			}
		}
	}
}

// ComplexPacketConfig is [Sim.ComplexPacket] with wavelength and width from
// [Config], and amp relative to [Config.Amplitude].
func (ss *Sim) ComplexPacketConfig(posA, posB enums.Enum, dim math32.Dims, ctr math32.Vector3, dir, phase, amp float32) {
	ss.ComplexPacket(posA, posB, dim, ctr, dir, ss.Config.Wavelength, ss.Config.PacketWidth, phase, ss.Config.Amplitude*amp)
}

// MovingWavePacketConfig is a version of [MovingWavePacket] that takes its
// wavelength and width variables from [Config]. amp is relative to
// [Config.Amplitude].
func (ss *Sim) MovingWavePacketConfig(posVar, velVar enums.Enum, dim math32.Dims, ctr math32.Vector3, dir, phase, amp float32) {
	ss.MovingWavePacket(posVar, velVar, dim, ctr, dir, ss.Config.Wavelength, ss.Config.PacketWidth, phase, ss.Config.Amplitude*amp)
}

// LatticeFreq returns the lattice angular frequency in radians per step, for a
// wave of given carrier wavelength and mass, both in cube units:
//
//	omega = c sqrt(khat^2 + m^2),  khat = 2 sin(k/2)
//
// khat, not k: that is what the discrete Laplacian sees. Using k mistunes the
// packet and leaves a backward-moving remnant.
func (ss *Sim) LatticeFreq(wavelength, mass float32) float32 {
	k := TwoPi / wavelength
	khat := 2 * math32.Sin(k/2)
	return ss.Params.C * math32.Sqrt(khat*khat+mass*mass)
}

// SlabPacket adds a ONE-WAY travelling wave packet to a gauge potential and
// its velocity: a cosine carrier under a Gaussian envelope along dim, centered
// at ctr and uniform across the other two dims. A slab, not a blob, so it does
// not diffract and the speed stays unambiguous to the eye.
//
// The velocity is the point: for psi = env(d) cos(k d - om t) the initial time
// derivative is om env sin(k d), with dir flipping the direction. Setting only
// the position splits it into two halves running opposite ways.
//
// dim is normally [math32.X], the horizontal display axis; pos should then be
// a TRANSVERSE component, normally Y, which the X-Z view draws vertically.
// phase shifts the carrier under the envelope: two packets a quarter cycle
// apart in orthogonal components make a circularly polarized wave.
func (ss *Sim) SlabPacket(pos, vel enums.Enum, dim math32.Dims, ctr, wavelength, width, amp, dir, om, phase float32) {
	pi := int(pos.Int64())
	vi := int(vel.Int64())
	ctx := GetCtx(0)
	cur := ctx.CurState
	prv := ctx.PrevState()
	sz := ss.Config.Size
	k := TwoPi / wavelength
	var c math32.Vector3i
	for c.Z = range sz.Z {
		for c.Y = range sz.Y {
			for c.X = range sz.X {
				d := float32(c.Dim(dim)) - ctr
				g := d / width
				env := amp * math32.FastExp(-g*g)
				ph := k*d + phase
				pv := env * math32.Cos(ph)
				vv := dir * om * env * math32.Sin(ph)
				f := c.AddScalar(1)
				State[f.Z, f.Y, f.X, pi, cur] += pv
				State[f.Z, f.Y, f.X, pi, prv] += pv
				State[f.Z, f.Y, f.X, vi, cur] += vv
				State[f.Z, f.Y, f.X, vi, prv] += vv
			}
		}
	}
}

// SlabPacketConfig is a version of [SlabPacket] that takes its wavelength and
// width variables from [Config]. amp is relative to [Config.Amplitude], so a
// caller can keep a mixing weight such as cos(theta_W) in amp and leave the
// overall size to the user.
func (ss *Sim) SlabPacketConfig(pos, vel enums.Enum, dim math32.Dims, ctr, amp, dir, om, phase float32) {
	ss.SlabPacket(pos, vel, dim, ctr, ss.Config.Wavelength, ss.Config.PacketWidth, ss.Config.Amplitude*amp, dir, om, phase)
}

// ChargedRest gives whatever is already in CabAs the velocity that makes it
// a charge distribution at rest: phi_b stays zero and d phi_b turns at the
// rest mass frequency, so that
//
//	rho = -sign e |chi|^2
//
// pointwise, whatever shape phi_a has. sign picks which way the complex phase
// turns, and so the sign of the charge -- the only difference between a
// particle and its antiparticle at this level.
//
// With Params.EM on, the local A0 is subtracted from the turning rate. A
// potential shifts the phase rate by -e A0 / hbar, so a wave genuinely at rest
// in that potential turns at Omega0 - e A0 / hbar. Leaving it out starts the
// wave in a superposition of the two frequencies present, and |chi|^2 beats
// instead of sitting still.
func (ss *Sim) ChargedRest(sign float32) {
	om := ss.Params.Omega0
	eoh := float32(0)
	if ss.Params.EM.IsTrue() {
		eoh = ss.Params.E / ss.Params.Hbar
	}
	ctx := GetCtx(0)
	cur := ctx.CurState
	prv := ctx.PrevState()
	sz := ss.Config.Size
	var c math32.Vector3i
	for c.Z = range sz.Z {
		for c.Y = range sz.Y {
			for c.X = range sz.X {
				f := c.AddScalar(1)
				v := sign * (om - eoh*State[f.Z, f.Y, f.X, A0s, cur]) * State[f.Z, f.Y, f.X, CabAs, cur]
				State[f.Z, f.Y, f.X, CabBv, cur] += v
				State[f.Z, f.Y, f.X, CabBv, prv] += v
			}
		}
	}
}

// ChargedUniform fills all of space with a charge at rest: the flat case, where
// rho is the same everywhere and exactly constant. See [Sim.ChargedRest].
func (ss *Sim) ChargedUniform(amp, sign float32) {
	ss.Fill(CabAs, Both, amp)
	ss.ChargedRest(sign)
}

// ChargedBlob puts a gaussian lump of charge at rest at ctr. See
// [Sim.ChargedRest].
func (ss *Sim) ChargedBlob(ctr math32.Vector3, width, amp, sign float32) {
	ss.Gauss(CabAs, Both, ctr, width, amp, 0)
	ss.ChargedRest(sign)
}

// DiracBlob puts a gaussian lump of Dirac charge at rest at ctr, with its spin
// along the given axis. sign picks the sense of the complex rotation, and so
// the sign of the charge, exactly as in [Sim.ChargedRest].
//
// Spin along Z is the component-1 state on its own; along X or Y it is the
// equal superposition of the two, which is what a spin pointing sideways IS in
// this basis -- there is no third pair of variables for it to live in.
func (ss *Sim) DiracBlob(ctr math32.Vector3, width, amp float32, axis math32.Dims, sign float32) {
	h := amp / math32.Sqrt2
	switch axis {
	case math32.X:
		ss.Gauss(Dirac1As, Both, ctr, width, h, 0)
		ss.Gauss(Dirac2As, Both, ctr, width, h, 0)
	case math32.Y:
		ss.Gauss(Dirac1As, Both, ctr, width, h, 0)
		ss.Gauss(Dirac2Bs, Both, ctr, width, h, 0)
	default:
		ss.Gauss(Dirac1As, Both, ctr, width, amp, 0)
	}
	ss.DiracRest(sign)
}

// DiracRest gives whatever is already in the Dirac position variables the
// velocity that makes it a charge at rest, as [Sim.ChargedRest] does for the
// single complex component: each component turns at the rest mass frequency,
// so rho = -sign e |psi|^2 pointwise.
func (ss *Sim) DiracRest(sign float32) {
	om := ss.Params.Omega0
	eoh := float32(0)
	if ss.Params.EM.IsTrue() {
		eoh = ss.Params.E / ss.Params.Hbar
	}
	ctx := GetCtx(0)
	cur := ctx.CurState
	prv := ctx.PrevState()
	sz := ss.Config.Size
	var c math32.Vector3i
	for c.Z = range sz.Z {
		for c.Y = range sz.Y {
			for c.X = range sz.X {
				f := c.AddScalar(1)
				w := sign * (om - eoh*State[f.Z, f.Y, f.X, A0s, cur])
				// d(chi) = i w chi for each component: (a, b) -> (-w b, w a)
				v1a := -w * State[f.Z, f.Y, f.X, Dirac1Bs, cur]
				v1b := w * State[f.Z, f.Y, f.X, Dirac1As, cur]
				v2a := -w * State[f.Z, f.Y, f.X, Dirac2Bs, cur]
				v2b := w * State[f.Z, f.Y, f.X, Dirac2As, cur]
				State[f.Z, f.Y, f.X, Dirac1Av, cur] += v1a
				State[f.Z, f.Y, f.X, Dirac1Av, prv] += v1a
				State[f.Z, f.Y, f.X, Dirac1Bv, cur] += v1b
				State[f.Z, f.Y, f.X, Dirac1Bv, prv] += v1b
				State[f.Z, f.Y, f.X, Dirac2Av, cur] += v2a
				State[f.Z, f.Y, f.X, Dirac2Av, prv] += v2a
				State[f.Z, f.Y, f.X, Dirac2Bv, cur] += v2b
				State[f.Z, f.Y, f.X, Dirac2Bv, prv] += v2b
			}
		}
	}
}

// ChargedPacketConfig adds a travelling complex wave packet along dim, with
// the two components a quarter cycle apart so it carries charge. Takes its
// wavelength and width from [Config]. sign picks the sign of the charge.
//
// Built from [Sim.SlabPacket] at the exact lattice frequency for this mass, so
// it is a clean positive-frequency packet running one way, with chi going as
// env times e to the i kx minus i omega t, for which rho is env^2 times a
// constant. [Sim.MovingWavePacket] would
// be the obvious choice but its velocity comes from fitted constants tuned for
// massless waves, so the packet it makes is not a KG eigenstate and splits.
func (ss *Sim) ChargedPacketConfig(dim math32.Dims, amp, sign float32) {
	wl := ss.Config.Wavelength
	om := ss.LatticeFreq(wl, math32.Sqrt(ss.Params.MOverHSq))
	ctr := float32(ss.Config.Size.Dim(dim)) * 0.5
	wd := ss.Config.PacketWidth
	ss.SlabPacket(CabAs, CabAv, dim, ctr, wl, wd, amp, 1, om, 0)
	ss.SlabPacket(CabBs, CabBv, dim, ctr, wl, wd, amp, 1, om, -sign*0.5*math32.Pi)
}

// SmoothNoise seeds a state variable with a sum of a few long-wavelength modes
// rather than per-site white noise, which would put power at the lattice
// cutoff and destabilize a nonlinear solver.
func (ss *Sim) SmoothNoise(vr EWStates, amp float32, nmodes int) {
	vri := int(vr.Int64())
	ctx := GetCtx(0)
	cur := ctx.CurState
	prv := ctx.PrevState()
	sz := ss.Config.Size
	ma := amp / math32.Sqrt(float32(nmodes))
	for range nmodes {
		nx := float32(ss.Rand.Intn(3) + 1)
		ny := float32(ss.Rand.Intn(3) + 1)
		nz := float32(ss.Rand.Intn(3) + 1)
		ph := TwoPi * ss.Rand.Float32()
		kx := TwoPi * nx / float32(sz.X)
		ky := TwoPi * ny / float32(sz.Y)
		kz := TwoPi * nz / float32(sz.Z)
		var c math32.Vector3i
		for c.Z = range sz.Z {
			for c.Y = range sz.Y {
				for c.X = range sz.X {
					f := c.AddScalar(1)
					v := ma * math32.Sin(kx*float32(c.X)+ky*float32(c.Y)+kz*float32(c.Z)+ph)
					State[f.Z, f.Y, f.X, vri, cur] += v
					State[f.Z, f.Y, f.X, vri, prv] += v
				}
			}
		}
	}
}

// Quadratic adds a parabolic bowl coef * r^2 centered at ctr: the harmonic
// oscillator potential.
func (ss *Sim) Quadratic(vr enums.Enum, ctr math32.Vector3, coef float32) {
	vri := int(vr.Int64())
	ctx := GetCtx(0)
	cur := ctx.CurState
	prv := ctx.PrevState()
	ctr = CenterF(ctr)
	sz := ss.Config.Size
	var c math32.Vector3i
	for c.Z = range sz.Z {
		for c.Y = range sz.Y {
			for c.X = range sz.X {
				f := c.AddScalar(1)
				d := CoordToFloat(c).Sub(ctr).Length()
				v := coef * d * d
				State[f.Z, f.Y, f.X, vri, cur] += v
				State[f.Z, f.Y, f.X, vri, prv] += v
			}
		}
	}
}

// Expo adds amp * exp(-r / decay) centered at ctr: the shape of a bound state
// in a Coulomb potential, as opposed to the gaussian of a harmonic one.
func (ss *Sim) Expo(vr enums.Enum, curPrev CurPrevBoth, ctr math32.Vector3, decay, amp float32) {
	vri := int(vr.Int64())
	ctx := GetCtx(0)
	cur := ctx.CurState
	prv := ctx.PrevState()
	ctr = CenterF(ctr)
	sz := ss.Config.Size
	var c math32.Vector3i
	for c.Z = range sz.Z {
		for c.Y = range sz.Y {
			for c.X = range sz.X {
				f := c.AddScalar(1)
				d := CoordToFloat(c).Sub(ctr).Length()
				v := amp * math32.FastExp(-d/decay)
				if curPrev == CurOnly || curPrev == Both {
					State[f.Z, f.Y, f.X, vri, cur] += v
				}
				if curPrev == PrevOnly || curPrev == Both {
					State[f.Z, f.Y, f.X, vri, prv] += v
				}
			}
		}
	}
}

// SineBox adds the product of half-sine waves that vanish on the walls, which
// is the ground state of a particle in a box: sin(n pi x / L) in each
// dimension that is more than one cube deep, with L the wall separation.
// Use with EdgesFixed, which is what holds the walls at zero.
func (ss *Sim) SineBox(vr enums.Enum, curPrev CurPrevBoth, n int32, amp float32) {
	vri := int(vr.Int64())
	ctx := GetCtx(0)
	cur := ctx.CurState
	prv := ctx.PrevState()
	sz := ss.Config.Size
	fn := float32(n)
	var c math32.Vector3i
	for c.Z = range sz.Z {
		for c.Y = range sz.Y {
			for c.X = range sz.X {
				f := c.AddScalar(1)
				v := amp
				for d := math32.X; d <= math32.Z; d++ {
					ln := sz.Dim(d)
					if ln <= 1 {
						continue
					}
					// walls sit at 0 and ln+1, so the separation is ln+1
					v *= math32.Sin(fn * math32.Pi * float32(c.Dim(d)+1) / float32(ln+1))
				}
				if curPrev == CurOnly || curPrev == Both {
					State[f.Z, f.Y, f.X, vri, cur] += v
				}
				if curPrev == PrevOnly || curPrev == Both {
					State[f.Z, f.Y, f.X, vri, prv] += v
				}
			}
		}
	}
}

// InvR adds 1/r values radiating from given center point,
// with peak point as given value.
func (ss *Sim) InvR(vr enums.Enum, ctr math32.Vector3, val float32) {
	vri := int(vr.Int64())
	ctx := GetCtx(0)
	cur := ctx.CurState
	ctr = CenterF(ctr)
	ctri := CoordToInt(ctr)
	sz := ss.Config.Size
	var c math32.Vector3i
	for c.Z = range sz.Z {
		for c.Y = range sz.Y {
			for c.X = range sz.X {
				f := c.AddScalar(1)
				ff := CoordToFloat(c)
				d := ff.Sub(ctr).Length()
				if c == ctri {
					State[f.Z, f.Y, f.X, vri, cur] += val
				} else {
					State[f.Z, f.Y, f.X, vri, cur] += val / d
				}
			}
		}
	}
}

// InvRDrive adds pow(decay, r) values radiating from given center point,
// with peak point as given value, which is used for the drive value
// in the spinfield model.
func (ss *Sim) InvRDrive(vr enums.Enum, ctr math32.Vector3, decay float32) {
	vri := int(vr.Int64())
	ctx := GetCtx(0)
	cur := ctx.CurState
	ctr = CenterF(ctr)
	ctri := CoordToInt(ctr)
	sz := ss.Config.Size
	var c math32.Vector3i
	for c.Z = range sz.Z {
		for c.Y = range sz.Y {
			for c.X = range sz.X {
				f := c.AddScalar(1)
				ff := CoordToFloat(c)
				d := ff.Sub(ctr).Length()
				if c == ctri {
					State[f.Z, f.Y, f.X, vri, cur] += 1
				} else {
					State[f.Z, f.Y, f.X, vri, cur] += math32.Pow(decay, d)
				}
			}
		}
	}
}

// ParticleAt adds a particle at given point, setting the normalized particle
// velocity factors.
func (ss *Sim) ParticleAt(c math32.Vector3i, pvel math32.Vector3, partType float32) {
	ss.Point(SpinfieldParticle, Both, c, partType)
	ss.Point(SpinfieldPvelX, Both, c, pvel.X)
	ss.Point(SpinfieldPvelY, Both, c, pvel.Y)
	ss.Point(SpinfieldPvelZ, Both, c, pvel.Z)

	ss.Point(Spinfield0a, CurOnly, c, 1.0)
	ss.Point(Spinfield0b, CurOnly, c, 0.0)

	// todo: simpler now
	// mch := math32.Sqrt(Params[0].MOverHSq * Params[0].CSq)
