//gosl:end

func (ss *Sim) StandardConfig() {
	ParamsShouldDisplay = ParticleDisplay
	ss.StateVars = StdStatesN
	ss.ViewInit(func(view *View) {
		view.SetVar(StdCs0a, -1)
	})
}

// StandardViewAll configures the View to display Standard values
func StandardViewAll(view *View) {
	view.Settings.NPanels = PanelsFour
	view.Settings.Camera = 2
	view.Settings.Height = 0.8
	view.Panels[0].Var = StdCs0a
	view.Panels[1].Var = StdCs0b
	// view.SetCurPrev(Previous, 1)
	view.Panels[2].Var = StdCs0b
	// view.SetCurPrev(Previous, 3)
	view.Panels[3].Var = StdCs1a
	view.Settings.TrackParticle = 0
}

func (ss *Sim) StandardStats() {
	ss.AddStat(ss.StatStep())
	ss.AddStat(ss.StatSum(CabCC))
	ss.AddStat(ss.StatParticle(0))
	ss.AddStat(ss.StatParticle(0))
}

// StandardDisplay determines which Parameters fields to display.
var StandardDisplay = []string{"Edges", "Energy", "C", "Diff", "Decay", "Hbar", "Mass", "Wavelength", "PacketWidth", "Velocity", "Move"}
