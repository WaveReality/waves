package wavesim

//gosl:start

// KleinGordonKernel is the kernel for computing the KleinGordon equations,
// on scalar state values (WaveStates).
func KleinGordonKernel(i uint32) { //gosl:kernel
	ctx := GetCtx(0)
	var x, y, z int32
	ok := ctx.StateCoords(i, &x, &y, &z)
	if !ok {
		return
	}
	cur := ctx.CurState
	prv := ctx.PrevState()
	ppos := State[z, y, x, WavePos, prv]
	pvel := State[z, y, x, WaveVel, prv]
	vpot := State[z, y, x, WaveV, prv]

	mhsq := Params[0].MOverHSq
	csq := Params[0].CSq

	var force float32
	if Params[0].ThreeD.IsTrue() {
		force = Laplacian19(x, y, z, int32(WavePos), prv, ppos)
	} else {
		force = Laplacian1D(x, y, z, int32(WavePos), prv, ppos)
	}
	force += (vpot - mhsq) * ppos // this is the only diff from standard Wave
	vel := pvel + csq*force
	pos := ppos + vel

	if Params[0].Energy.IsTrue() {
		midVel := 0.5 * (pvel + vel)
		kinetic := Params[0].Inv2CSq * midVel * midVel
		var potential float32
		if Params[0].ThreeD.IsTrue() {
			potential = PotentialEnergy19(x, y, z, int32(WavePos), prv, ppos)
		} else {
			potential = PotentialEnergy1D(x, y, z, int32(WavePos), prv, ppos)
		}

		State[z, y, x, WaveKinetic, cur] = kinetic
		State[z, y, x, WavePotential, cur] = potential
		State[z, y, x, WaveEnergy, cur] = kinetic + potential
	}
	State[z, y, x, WaveForce, cur] = force
	State[z, y, x, WaveVel, cur] = vel
	State[z, y, x, WavePos, cur] = pos
}

// KleinGordonDampKernel is the kernel for computing the KleinGordon equations,
// on scalar state values (WaveStates),
// at damped edges. Does Sommerfield damping where velocity = force.
func KleinGordonDampKernel(i uint32) { //gosl:kernel
	ctx := GetCtx(0)
	var x, y, z int32
	face := ctx.EdgeCoords(i, &x, &y, &z)
	if face < 0 {
		return
	}
	sz := ctx.SizePlus1() // exclude updating on edges
	cur := ctx.CurState
	prv := ctx.PrevState()
	ppos := State[z, y, x, WavePos, prv]

	mhsq := Params[0].MOverHSq
	csq := Params[0].CSq

	var force float32
	if Params[0].ThreeD.IsTrue() {
		force = LaplacianEdge19(x, y, z, sz.X, sz.Y, sz.Z, int32(WavePos), prv, ppos)
	} else {
		force = LaplacianEdge1D(x, y, z, sz.X, sz.Y, sz.Z, int32(WavePos), prv, ppos)
	}
	force -= mhsq * ppos // this is the only diff from standard Wave
	vel := csq * force   // key damp: no +=
	pos := ppos + vel

	State[z, y, x, WaveForce, cur] = force
	State[z, y, x, WaveVel, cur] = vel
	State[z, y, x, WavePos, cur] = pos
}

//gosl:end

func (ss *Sim) KleinGordonConfig() {
	ParamsShouldDisplay = KGShouldDisplay
	ss.StateVars = WaveStatesN
	// the SAME configs Wave uses, on the same state: switch equation and the
	// only thing that changes is the mass term
	ss.initFuncs = WaveConfigs
	ss.InitFunc = WavePacket
	ss.Params.C = 0.5
	ss.Params.Mass = 0.125
	ss.Params.Update()
	ss.WaveStats()
	ss.eqViewInitFunc = WaveViewAll
}

// KGShouldDisplay determines which Parameters fields to display.
var KGShouldDisplay = []string{"Edges", "Energy", "C", "Mass", "VPotential", "Wavelength", "PacketWidth", "Amplitude"}
