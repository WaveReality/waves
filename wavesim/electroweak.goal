package wavesim

import (
	"cogentcore.org/core/math32"
	"cogentcore.org/lab/gosl/slmath"
)

//gosl:start
//gosl:import "cogentcore.org/lab/gosl/slmath"

// EWStates are the state variables for the Electroweak Model.
type EWStates EMStates //enums:enum -trim-prefix=EW

const (
	// EWHsCa is the Higgs doublet charged state Ca (real)
	EWHsCa EWStates = EWStates(EMStatesN) + iota

	// EWHsCb is the Higgs doublet charged state Cb (imaginary)
	EWHsCb

	// EWHs0a is the Higgs doublet neutral state 0a (real)
	EWHs0a

	// EWHs0b is the Higgs doublet neutral state 0b (imaginary)
	EWHs0b

	// EWHvCa is the Higgs doublet charged vel 0a (real)
	EWHvCa

	// EWHvCb is the Higgs doublet charged vel 0b (imaginary)
	EWHvCb

	// EWHv0a is the Higgs doublet neutral vel 0a (real)
	EWHv0a

	// EWHv0b is the Higgs doublet neutral vel 0b (imaginary)
	EWHv0b

	// EWHmag is the Higgs magnitude (h.c. * state = squared magnitude)
	EWHmag

	// EWV is the Higgs potential as a function of Hmag
	EWHV

	// EWB0s is the B weak hypercharge scalar potential 0 component.
	EWB0s

	// EWBXs is the B weak hypercharge vector potential X component.
	EWBXs

	// EWBYs is the B weak hypercharge vector potential Y component.
	EWBYs

	// EWBZs is the B weak hypercharge vector potential Z component.
	EWBZs

	// EWB0v is the B weak hypercharge scalar potential 0 velocity.
	EWB0v

	// EWBXv is the B weak hypercharge vector potential X velocity.
	EWBXv

	// EWBYv is the B weak hypercharge vector potential Y velocity.
	EWBYv

	// EWBZv is the B weak hypercharge vector potential Z velocity.
	EWBZv

	// EWW10s is the W weak isospin 1 scalar potential 0 component.
	EWW10s

	// EWW1Xs is the W weak isospin 1 vector potential X component.
	EWW1Xs

	// EWW1Ys is the W weak isospin 1 vector potential Y component.
	EWW1Ys

	// EWW1Zs is the W weak isospin 1 vector potential Z component.
	EWW1Zs

	// EWW10v is the W weak isospin 1 scalar potential 0 velocity.
	EWW10v

	// EWW1Xv is the W weak isospin 1 vector potential X velocity.
	EWW1Xv

	// EWW1Yv is the W weak isospin 1 vector potential Y velocity.
	EWW1Yv

	// EWW1Zv is the W weak isospin 1 vector potential Z velocity.
	EWW1Zv

	// EWW20s is the W weak isospin 2 scalar potential 0 component.
	EWW20s

	// EWW2Xs is the W weak isospin 2 vector potential X component.
	EWW2Xs

	// EWW2Ys is the W weak isospin 2 vector potential Y component.
	EWW2Ys

	// EWW2Zs is the W weak isospin 2 vector potential Z component.
	EWW2Zs

	// EWW20v is the W weak isospin 2 scalar potential 0 velocity.
	EWW20v

	// EWW2Xv is the W weak isospin 2 vector potential X velocity.
	EWW2Xv

	// EWW2Yv is the W weak isospin 2 vector potential Y velocity.
	EWW2Yv

	// EWW2Zv is the W weak isospin 2 vector potential Z velocity.
	EWW2Zv

	// EWW30s is the W weak isospin 3 scalar potential 0 component.
	EWW30s

	// EWW3Xs is the W weak isospin 3 vector potential X component.
	EWW3Xs

	// EWW3Ys is the W weak isospin 3 vector potential Y component.
	EWW3Ys

	// EWW3Zs is the W weak isospin 3 vector potential Z component.
	EWW3Zs

	// EWW30v is the W weak isospin 3 scalar potential 0 velocity.
	EWW30v

	// EWW3Xv is the W weak isospin 3 vector potential X velocity.
	EWW3Xv

	// EWW3Yv is the W weak isospin 3 vector potential Y velocity.
	EWW3Yv

	// EWW3Zv is the W weak isospin 3 vector potential Z velocity.
	EWW3Zv

	//////// Derived mass-eigenstate views.
	//
	// These are not evolved: the dynamics lives entirely in (W^1, W^2, W^3, B),
	// and these are recomputed from them every step. They are the physical
	// basis -- what an experiment sees -- as opposed to the gauge basis the
	// equations are written in.
	//
	// The photon does NOT appear here: it is written into the ordinary Maxwell
	// state variables A0s..AZs instead, because it is the electromagnetic
	// field, not a separate thing.

	// EWZ0 is the Z boson scalar potential, cos(theta_W) W^3_0 - sin(theta_W) B_0.
	EWZ0

	// EWZX is the Z boson vector potential, X component.
	EWZX

	// EWZY is the Z boson vector potential, Y component.
	EWZY

	// EWZZ is the Z boson vector potential, Z component.
	EWZZ

	// EWWPr0 is Re(W^+_0), where W^+_mu = (W^1_mu - i W^2_mu)/sqrt(2).
	//
	// W^- is the CONJUGATE of W^+, not an independent field: the charged sector
	// has exactly two real degrees of freedom per spacetime index, W^1 and W^2,
	// and the +/- basis repackages them as one complex field. So Re and Im of
	// W^+ carry everything; EWWMag below is the amplitude both charge states
	// share.
	EWWPr0

	// EWWPrX, EWWPrY, EWWPrZ are Re(W^+) for the vector components.
	EWWPrX
	EWWPrY
	EWWPrZ

	// EWWPi0, EWWPiX, EWWPiY, EWWPiZ are Im(W^+_mu) = -W^2_mu/sqrt(2).
	EWWPi0
	EWWPiX
	EWWPiY
	EWWPiZ

	// EWWMag is the charged-W amplitude, sum_mu |W^+_mu|^2, identical for
	// W^+ and W^-. It is the basis-independent measure of how much charged W
	// field is present, which the two real components above encode.
	EWWMag
)

// YPhi is the weak hypercharge of the Higgs doublet in the Q = T^3 + Y
// convention. Together with T^3 = -1/2 for the lower component this makes
// Q = 0 there, so the photon does not couple to the vacuum and stays massless.
const YPhi = 0.5

// InvSqrt2 is 1/sqrt(2), the normalization of the W^+/W^- basis.
const InvSqrt2 = 0.70710678118654752440

// EWGaugeAct returns -i * G * Psi in real components, where G is the Hermitian
// 2x2 gauge matrix that the covariant derivative is built from:
//
//	G = g W^a T^a + g' Y_Phi B,   T^a = sigma^a / 2
//	  = [[ du, or + i oi ], [ or - i oi, dd ]]
//	du = (g/2) W3 + g' Y B      or = (g/2) W1
//	dd = -(g/2) W3 + g' Y B     oi = -(g/2) W2
//
// The opposite sign of W3 on the diagonal is T^3 = +-1/2: why the upper and
// lower components feel W3 oppositely but B identically. The combination
// annihilating the vacuum is Q = T^3 + Y, the one massless direction.
//
// This one operation is the entire gauge coupling: D_mu Psi = d_mu Psi +
// EWGaugeAct(W_mu, B_mu, Psi), and the covariant Laplacian composes from it.
// Psi is the doublet as four reals, (X + iY, Z + iW) = sqrt(2) Phi.
func EWGaugeAct(w1, w2, w3, b float32, psi math32.Vector4) math32.Vector4 {
	hg := 0.5 * Params[0].GW
	gy := Params[0].GpW * YPhi
	du := hg*w3 + gy*b
	dd := -hg*w3 + gy*b
	or := hg * w1
	oi := -hg * w2
	var o math32.Vector4
	o.X = du*psi.Y + or*psi.W + oi*psi.Z
	o.Y = -(du*psi.X + or*psi.Z - oi*psi.W)
	o.Z = or*psi.Y - oi*psi.X + dd*psi.W
	o.W = -(or*psi.X + oi*psi.Y + dd*psi.Z)
	return o
}

// EWCurrent returns the four gauge currents that a doublet Psi with covariant
// derivative d = D_mu Psi puts into the gauge fields at spacetime index mu:
//
//	X,Y,Z = j^a_mu = 2 g  Im[Phi^dag T^a D_mu Phi]   (a = 1,2,3, sourcing W^a)
//	W     = j^Y_mu = 2 g' Y Im[Phi^dag D_mu Phi]     (sourcing B)
//
// with Phi = Psi/sqrt(2) folding one factor of 1/2 into each expression.
//
// NOTHING in this kernel contains a gauge boson mass term. The masses arise
// because Psi is non-zero everywhere: evaluated at the vacuum this current
// reduces to exactly -m^2 times the gauge field itself, uniformly and
// permanently. That feedback is the Higgs mechanism.
func EWCurrent(psi, d math32.Vector4) math32.Vector4 {
	hg := 0.5 * Params[0].GW
	gy := Params[0].GpW * YPhi
	var j math32.Vector4
	j.X = hg * ((psi.X*d.W - psi.Y*d.Z) + (psi.Z*d.Y - psi.W*d.X))
	j.Y = hg * (-(psi.X*d.Z + psi.Y*d.W) + (psi.Z*d.X + psi.W*d.Y))
	j.Z = hg * ((psi.X*d.Y - psi.Y*d.X) - (psi.Z*d.W - psi.W*d.Z))
	j.W = gy * ((psi.X*d.Y - psi.Y*d.X) + (psi.Z*d.W - psi.W*d.Z))
	return j
}

// EWDiv returns the lattice divergence of a 3-vector gauge potential whose
// X, Y, Z components are the three consecutive state variables at vX.
func EWDiv(x, y, z, vX, tidx int32) float32 {
	gx := Gradient10(x, y, z, vX, tidx)
	gy := Gradient10(x, y, z, vX+1, tidx)
	gz := Gradient10(x, y, z, vX+2, tidx)
	return gx.X + gy.Y + gz.Z
}

// EWCrossUp returns sum_mu (A^mu x B_mu), the contraction of an UPPER with a
// LOWER spacetime index. No metric signs: all four terms add.
//
// Every eps^{abc} in the Yang-Mills equation is a cross product in adjoint
// space, since eps^{abc} X^b Y^c = (X x Y)^a. Writing the self-coupling this
// way turns a triple-index mess into four cross products.
func EWCrossUp(a0, ax, ay, az, b0, bx, by, bz math32.Vector3) math32.Vector3 {
	r := slmath.Cross3(a0, b0)
	r = r.Add(slmath.Cross3(ax, bx))
	r = r.Add(slmath.Cross3(ay, by))
	r = r.Add(slmath.Cross3(az, bz))
	return r
}

// EWCrossLor returns sum_mu (A_mu x B^mu) where BOTH carry the same index
// position, so the (+,-,-,-) metric appears: time adds, space subtracts.
func EWCrossLor(a0, ax, ay, az, b0, bx, by, bz math32.Vector3) math32.Vector3 {
	r := slmath.Cross3(a0, b0)
	r = r.Sub(slmath.Cross3(ax, bx))
	r = r.Sub(slmath.Cross3(ay, by))
	r = r.Sub(slmath.Cross3(az, bz))
	return r
}

// EWBorisRot3 is the Boris rotation for an adjoint 3-vector velocity: the
// EXACT, norm-preserving update for dv/dt = v x Omega over one unit step.
//
//	t = Omega/2 ;  v' = v + v x t ;  v+ = v + v' x (2t / (1 + |t|^2))
//
// The two half-turns compose into a true rotation, which is the whole point:
// the velocity-dependent gauge force does not change |v|, and an explicit
// update gets that wrong at O(Omega^2) EVERY step, which is what makes the
// rotating-frame system blow up.
func EWBorisRot3(v, om math32.Vector3) math32.Vector3 {
	t := om.MulScalar(0.5)
	vp := v.Add(slmath.Cross3(v, t))
	s := t.MulScalar(2.0 / (1.0 + slmath.LengthSquared3(t)))
	return v.Add(slmath.Cross3(vp, s))
}

// EWBorisPhase rotates the Higgs velocity by exp(i theta G_0), the exact
// solution of the velocity-dependent part of the Higgs equation,
//
//	dv/dt = -2c (-i G_0) v = 2ic G_0 v   ->   v(1) = exp(2ic G_0) v(0)
//
// so theta = 2c. For the 2x2 Hermitian gauge matrix this has a closed form:
// splitting G_0 = alpha I + m.sigma, with
//
//	m = (g/2) (W^1_0, W^2_0, W^3_0)   and   alpha = g' Y_Phi B_0
//
// the exponential is
//
//	exp(i theta alpha) * (cos(theta |m|) I + i sin(theta |m|) mhat.sigma)
//
// The SU(2) part turns the doublet, the U(1) part is an overall phase: the
// parallel transport the connection generates.
func EWBorisPhase(w1, w2, w3, b, theta float32, v math32.Vector4) math32.Vector4 {
	hg := 0.5 * Params[0].GW
	m := math32.Vec3(hg*w1, hg*w2, hg*w3)
	al := Params[0].GpW * YPhi * b
	mag := slmath.Length3(m)
	var nx, ny, nz, sn float32
	if mag > 1.0e-12 {
		nx = m.X / mag
		ny = m.Y / mag
		nz = m.Z / mag
		sn = math32.Sin(theta * mag)
	}
	cs := math32.Cos(theta * mag)
	// P = (mhat.sigma) Psi, in real components
	p1r := nz*v.X + nx*v.Z + ny*v.W
	p1i := nz*v.Y + nx*v.W - ny*v.Z
	p2r := nx*v.X - ny*v.Y - nz*v.Z
	p2i := nx*v.Y + ny*v.X - nz*v.W
	// Q = cos Psi + i sin P
	q1r := cs*v.X - sn*p1i
	q1i := cs*v.Y + sn*p1r
	q2r := cs*v.Z - sn*p2i
	q2i := cs*v.W + sn*p2r
	// overall U(1) phase exp(i theta alpha)
	ca := math32.Cos(theta * al)
	sa := math32.Sin(theta * al)
	return math32.Vec4(ca*q1r-sa*q1i, ca*q1i+sa*q1r, ca*q2r-sa*q2i, ca*q2i+sa*q2r)
}

// ElectroweakKernel is the kernel for the SU(2)_L x U(1)_Y electroweak model:
// the Higgs doublet coupled to the three W^a gauge fields and the B field.
// Only supports 3D.
//
// # Fields
//
// The Higgs doublet is four real fields,
//
//	Phi = (1/sqrt2) ( hsCa + i hsCb , hs0a + i hs0b )^T
//
// so mag = hsCa^2 + hsCb^2 + hs0a^2 + hs0b^2 = 2 Phi^dag Phi. The vacuum
// <Phi> = (0, v/sqrt2)^T is hs0a = v, rest zero. It MUST be the neutral
// (lower) component, or Q = T^3 + Y does not annihilate the vacuum and the
// photon gains mass.
//
// Each gauge field is a four-potential (0, X, Y, Z) with its own velocity, as
// in MaxwellKernel, evolved in Lorenz gauge:
//
//	box W^a_mu = j^a_mu,    box B_mu = j^Y_mu
//
// # Units
//
// Inverse cube units (1/cube) throughout, which is what makes g, g' and lambda
// the bare dimensionless SM numbers (see Units.Update).
//
// # Yang-Mills self-coupling
//
// Enabled by Params.YangMills. With a Feynman-type gauge-fixing term (xi = 1)
// cancelling the -d^nu(d.W) piece, the non-abelian equation of motion is
//
//	box W^a_nu = j^a_nu
//	             + g eps^abc (d.W^b) W^c_nu                  [divergence]
//	             + 2g eps^abc W^{b mu} d_mu W^c_nu           [transport]
//	             - g eps^abc W^b_mu d^nu W^{c mu}            [transpose]
//	             - g^2 eps^abc eps^cde (W^b.W^d) W^e_nu      [quartic]
//
// The three CUBIC signs are fixed by requiring force = -dU/dphi for the energy
// with F^a_jk = d_j W^a_k - d_k W^a_j + g eps^abc W^b_j W^c_k; see
// TestElectroweakForceIsEnergyGradient. The pure-gauge test cannot fix them:
// flipping the signs also reverses the rotation sense it predicts, so it
// passes either way. The quartic sign is independent, checked on uniform
// fields.
//
// The divergence term is kept, not dropped: unlike the abelian case d.W^a = 0
// is NOT preserved by the non-abelian evolution, so it cannot be imposed.
//
// All four terms are quadratic or cubic in W, so they vanish at linear order
// and leave the spectrum unchanged. What they add is the W self-interaction:
// the difference between SU(2) and three copies of U(1).
//
func ElectroweakKernel(i uint32) { //gosl:kernel
	ctx := GetCtx(0)
	var x, y, z int32
	ok := ctx.StateCoords(i, &x, &y, &z)
	if !ok {
		return
	}
	cur := ctx.CurState
	prv := ctx.PrevState()
	csq := Params[0].CSq
	oc := 1.0 / Params[0].C
	boris := Params[0].Boris.IsTrue()
	musq := Params[0].HiggsMuSq
	lambda := Params[0].HiggsLambda

	// ---- Higgs doublet and its velocity ----------------------------------
	psi := math32.Vec4(State[z, y, x, EWHsCa, prv], State[z, y, x, EWHsCb, prv],
		State[z, y, x, EWHs0a, prv], State[z, y, x, EWHs0b, prv])
	psv := math32.Vec4(State[z, y, x, EWHvCa, prv], State[z, y, x, EWHvCb, prv],
		State[z, y, x, EWHv0a, prv], State[z, y, x, EWHv0b, prv])

	// ---- gauge potentials, per spacetime index ---------------------------
	w10 := State[z, y, x, EWW10s, prv]
	w1x := State[z, y, x, EWW1Xs, prv]
	w1y := State[z, y, x, EWW1Ys, prv]
	w1z := State[z, y, x, EWW1Zs, prv]
	w20 := State[z, y, x, EWW20s, prv]
	w2x := State[z, y, x, EWW2Xs, prv]
	w2y := State[z, y, x, EWW2Ys, prv]
	w2z := State[z, y, x, EWW2Zs, prv]
	w30 := State[z, y, x, EWW30s, prv]
	w3x := State[z, y, x, EWW3Xs, prv]
	w3y := State[z, y, x, EWW3Ys, prv]
	w3z := State[z, y, x, EWW3Zs, prv]
	b0 := State[z, y, x, EWB0s, prv]
	bx := State[z, y, x, EWBXs, prv]
	by := State[z, y, x, EWBYs, prv]
	bz := State[z, y, x, EWBZs, prv]

	// ---- ordinary gradients of the four Higgs components -----------------
	gCa := Gradient10(x, y, z, int32(EWHsCa), prv)
	gCb := Gradient10(x, y, z, int32(EWHsCb), prv)
	g0a := Gradient10(x, y, z, int32(EWHs0a), prv)
	g0b := Gradient10(x, y, z, int32(EWHs0b), prv)

	dxp := math32.Vec4(gCa.X, gCb.X, g0a.X, g0b.X) // d_x Psi
	dyp := math32.Vec4(gCa.Y, gCb.Y, g0a.Y, g0b.Y)
	dzp := math32.Vec4(gCa.Z, gCb.Z, g0a.Z, g0b.Z)

	// ---- covariant derivatives D_mu Psi = d_mu Psi - i G_mu Psi ----------
	ax := EWGaugeAct(w1x, w2x, w3x, bx, psi)
	ay := EWGaugeAct(w1y, w2y, w3y, by, psi)
	az := EWGaugeAct(w1z, w2z, w3z, bz, psi)
	a0 := EWGaugeAct(w10, w20, w30, b0, psi)

	dX := dxp.Add(ax)
	dY := dyp.Add(ay)
	dZ := dzp.Add(az)
	// the time component: velocities are per step and c is cubes per step, so
	// psv/c is d_0 Psi in the same 1/cube units as the spatial gradients.
	dtp := math32.Vec4(oc*psv.X, oc*psv.Y, oc*psv.Z, oc*psv.W)
	d0 := dtp.Add(a0)

	// ---- covariant Laplacian ---------------------------------------------
	// D_j D_j Psi = d_j(D_j Psi) - i G_j (D_j Psi)
	//             = lap(Psi) - i(d_j G_j)Psi - i G_j d_j Psi - i G_j D_j Psi
	// Each -i G ... piece is just EWGaugeAct applied to a different argument,
	// so the whole covariant Laplacian composes out of the one operation.
	// Spatial gradients of all twelve W components. These serve double duty:
	// their traces give the divergences the Higgs covariant Laplacian needs,
	// and the full tensor is what the Yang-Mills self-coupling runs on.
	g10 := Gradient10(x, y, z, int32(EWW10s), prv)
	g1x := Gradient10(x, y, z, int32(EWW1Xs), prv)
	g1y := Gradient10(x, y, z, int32(EWW1Ys), prv)
	g1z := Gradient10(x, y, z, int32(EWW1Zs), prv)
	g20 := Gradient10(x, y, z, int32(EWW20s), prv)
	g2x := Gradient10(x, y, z, int32(EWW2Xs), prv)
	g2y := Gradient10(x, y, z, int32(EWW2Ys), prv)
	g2z := Gradient10(x, y, z, int32(EWW2Zs), prv)
	g30 := Gradient10(x, y, z, int32(EWW30s), prv)
	g3x := Gradient10(x, y, z, int32(EWW3Xs), prv)
	g3y := Gradient10(x, y, z, int32(EWW3Ys), prv)
	g3z := Gradient10(x, y, z, int32(EWW3Zs), prv)

	dvW1 := g1x.X + g1y.Y + g1z.Z
	dvW2 := g2x.X + g2y.Y + g2z.Z
	dvW3 := g3x.X + g3y.Y + g3z.Z
	dvB := EWDiv(x, y, z, int32(EWBXs), prv)

	lap := math32.Vec4(Laplacian19(x, y, z, int32(EWHsCa), prv, psi.X),
		Laplacian19(x, y, z, int32(EWHsCb), prv, psi.Y),
		Laplacian19(x, y, z, int32(EWHs0a), prv, psi.Z),
		Laplacian19(x, y, z, int32(EWHs0b), prv, psi.W))

	cov := lap.Add(EWGaugeAct(dvW1, dvW2, dvW3, dvB, psi))
	cov = cov.Add(EWGaugeAct(w1x, w2x, w3x, bx, dxp.Add(dX)))
	cov = cov.Add(EWGaugeAct(w1y, w2y, w3y, by, dyp.Add(dY)))
	cov = cov.Add(EWGaugeAct(w1z, w2z, w3z, bz, dzp.Add(dZ)))

	// ---- time-component gauge terms ---------------------------------------
	// D_0 D_0 Psi expands exactly as the spatial case does:
	//
	//	D_0D_0 Psi = (1/c^2) d_t^2 Psi + (1/c)(d_t G_0) Psi
	//	             + (1/c) G_0 d_t Psi + G_0 D_0 Psi
	//
	// and the equation of motion is D_0D_0 = vfac + D_jD_j, so solving it for
	// the acceleration SUBTRACTS the last three. Without these the Higgs
	// sources W_0 and B_0 through j_0 but never feels them back, which breaks
	// gauge invariance: a constant A_0 is pure gauge and must produce a phase
	// rotation at constant |Phi|, not a change in the magnitude.
	w1xv := State[z, y, x, EWW1Xv, prv]
	w1yv := State[z, y, x, EWW1Yv, prv]
	w1zv := State[z, y, x, EWW1Zv, prv]
	w2xv := State[z, y, x, EWW2Xv, prv]
	w2yv := State[z, y, x, EWW2Yv, prv]
	w2zv := State[z, y, x, EWW2Zv, prv]
	w3xv := State[z, y, x, EWW3Xv, prv]
	w3yv := State[z, y, x, EWW3Yv, prv]
	w3zv := State[z, y, x, EWW3Zv, prv]
	w10v := State[z, y, x, EWW10v, prv]
	w20v := State[z, y, x, EWW20v, prv]
	w30v := State[z, y, x, EWW30v, prv]
	b0v := State[z, y, x, EWB0v, prv]

	// Of the three, only the two built on dtp depend on the Higgs VELOCITY.
	// Together they are -2 G_0 (dPsi/dt)/c, i.e. exactly the connection acting
	// on the velocity -- a rotation. With Boris on they are left out here and
	// applied exactly below; otherwise they go in explicitly as before.
	q0 := EWGaugeAct(oc*w10v, oc*w20v, oc*w30v, oc*b0v, psi)
	qa := EWGaugeAct(w10, w20, w30, b0, a0)
	cov = cov.Sub(q0).Sub(qa)
	if !boris {
		qv := EWGaugeAct(w10, w20, w30, b0, dtp)
		cov = cov.Sub(qv).Sub(qv)
	}

	// ---- the potential ----------------------------------------------------
	// V = -(1/2) mu^2 mag + (1/4) lambda mag^2
	// force_i = -dV/dphi_i = (mu^2 - lambda*mag) * phi_i
	// The SAME radial factor multiplies EACH component, so the force points
	// along the field vector and depends only on |Phi|. That leaves the phase
	// directions exactly flat -- the Goldstone modes. At the vacuum
	// mag = mu^2/lambda, vfac = 0, and the state is exactly stationary.
	mag := psi.X*psi.X + psi.Y*psi.Y + psi.Z*psi.Z + psi.W*psi.W
	vfac := musq - lambda*mag

	hf := math32.Vec4(csq*(cov.X+vfac*psi.X), csq*(cov.Y+vfac*psi.Y),
		csq*(cov.Z+vfac*psi.Z), csq*(cov.W+vfac*psi.W))

	// ---- currents, one per spacetime index --------------------------------
	j0 := EWCurrent(psi, d0)
	jx := EWCurrent(psi, dX)
	jy := EWCurrent(psi, dY)
	jz := EWCurrent(psi, dZ)

	// ---- Yang-Mills self-coupling -----------------------------------------
	// Adjoint 3-vectors: for each spacetime index mu, the SU(2) triplet
	// (W^1_mu, W^2_mu, W^3_mu). In this form every eps^{abc} becomes a cross
	// product and the whole self-coupling is a handful of them.
	var ym0, ymx, ymy, ymz math32.Vector3
	if Params[0].YangMills.IsTrue() {
		gw := Params[0].GW
		w0 := math32.Vec3(w10, w20, w30)
		// wb is w0 for the explicit path; with Boris it is zeroed so the
		// mu = 0 transport term (the velocity-dependent one) is handled by the
		// exact rotation instead of being integrated explicitly.
		wb := w0
		if boris {
			wb = math32.Vec3(0, 0, 0)
		}
		wx := math32.Vec3(w1x, w2x, w3x)
		wy := math32.Vec3(w1y, w2y, w3y)
		wz := math32.Vec3(w1z, w2z, w3z)

		// d_mu W^nu, indexed [derivative direction][component]. The time
		// derivatives are the stored velocities: per step, so divide by c to
		// land in the same 1/cube units as the spatial gradients.
		t0 := math32.Vec3(w10v, w20v, w30v).MulScalar(oc)
		tx := math32.Vec3(w1xv, w2xv, w3xv).MulScalar(oc)
		ty := math32.Vec3(w1yv, w2yv, w3yv).MulScalar(oc)
		tz := math32.Vec3(w1zv, w2zv, w3zv).MulScalar(oc)

		x0 := math32.Vec3(g10.X, g20.X, g30.X)
		y0 := math32.Vec3(g10.Y, g20.Y, g30.Y)
		z0 := math32.Vec3(g10.Z, g20.Z, g30.Z)
		xx := math32.Vec3(g1x.X, g2x.X, g3x.X)
		yx := math32.Vec3(g1x.Y, g2x.Y, g3x.Y)
		zx := math32.Vec3(g1x.Z, g2x.Z, g3x.Z)
		xy := math32.Vec3(g1y.X, g2y.X, g3y.X)
		yy := math32.Vec3(g1y.Y, g2y.Y, g3y.Y)
		zy := math32.Vec3(g1y.Z, g2y.Z, g3y.Z)
		xz := math32.Vec3(g1z.X, g2z.X, g3z.X)
		yz := math32.Vec3(g1z.Y, g2z.Y, g3z.Y)
		zz := math32.Vec3(g1z.Z, g2z.Z, g3z.Z)

		// divergence d.W^a = d_0 W^{a0} + d_j W^{aj}, as an adjoint vector
		dv := t0.Add(xx).Add(yy).Add(zz)

		// [transport] -2g sum_mu (W^mu x d_mu W^nu)  (upper-lower, no signs)
		// [transpose] +g sum_mu (W_mu x d^nu W^mu)   (metric signs, and
		//             d^nu = +d_0 for nu=0 but -d_j for nu=j)
		// [quartic]   -g^2 sum_mu (W_mu x (W^mu x W^nu))
		// [divergence] -g (dv x W^nu)
		ym0 = EWCrossUp(wb, wx, wy, wz, t0, x0, y0, z0).MulScalar(2 * gw)
		ym0 = ym0.Sub(EWCrossLor(w0, wx, wy, wz, t0, tx, ty, tz).MulScalar(gw))
		ym0 = ym0.Sub(EWCrossLor(w0, wx, wy, wz,
			slmath.Cross3(w0, w0), slmath.Cross3(wx, w0),
			slmath.Cross3(wy, w0), slmath.Cross3(wz, w0)).MulScalar(gw * gw))
		ym0 = ym0.Add(slmath.Cross3(dv, w0).MulScalar(gw))

		ymx = EWCrossUp(wb, wx, wy, wz, tx, xx, yx, zx).MulScalar(2 * gw)
		ymx = ymx.Add(EWCrossLor(w0, wx, wy, wz, x0, xx, xy, xz).MulScalar(gw))
		ymx = ymx.Sub(EWCrossLor(w0, wx, wy, wz,
			slmath.Cross3(w0, wx), slmath.Cross3(wx, wx),
			slmath.Cross3(wy, wx), slmath.Cross3(wz, wx)).MulScalar(gw * gw))
		ymx = ymx.Add(slmath.Cross3(dv, wx).MulScalar(gw))

		ymy = EWCrossUp(wb, wx, wy, wz, ty, xy, yy, zy).MulScalar(2 * gw)
		ymy = ymy.Add(EWCrossLor(w0, wx, wy, wz, y0, yx, yy, yz).MulScalar(gw))
		ymy = ymy.Sub(EWCrossLor(w0, wx, wy, wz,
			slmath.Cross3(w0, wy), slmath.Cross3(wx, wy),
			slmath.Cross3(wy, wy), slmath.Cross3(wz, wy)).MulScalar(gw * gw))
		ymy = ymy.Add(slmath.Cross3(dv, wy).MulScalar(gw))

		ymz = EWCrossUp(wb, wx, wy, wz, tz, xz, yz, zz).MulScalar(2 * gw)
		ymz = ymz.Add(EWCrossLor(w0, wx, wy, wz, z0, zx, zy, zz).MulScalar(gw))
		ymz = ymz.Sub(EWCrossLor(w0, wx, wy, wz,
			slmath.Cross3(w0, wz), slmath.Cross3(wx, wz),
			slmath.Cross3(wy, wz), slmath.Cross3(wz, wz)).MulScalar(gw * gw))
		ymz = ymz.Add(slmath.Cross3(dv, wz).MulScalar(gw))
	}

	// ---- gauge field updates: box W = j, box B = j^Y ----------------------
	// Omega for the Boris rotation of the W velocities: the transport term is
	// dv/dt = v x Omega with Omega = -2 g c W_0.
	omW := math32.Vec3(w10, w20, w30).MulScalar(-2 * Params[0].GW * Params[0].C)
	nw := Params[0].A0NoWave.IsTrue()
	EWWStep(x, y, z, cur, prv, 0, csq, omW, math32.Vec3(j0.X+ym0.X, j0.Y+ym0.Y, j0.Z+ym0.Z), boris, nw)
	EWWStep(x, y, z, cur, prv, 1, csq, omW, math32.Vec3(jx.X+ymx.X, jx.Y+ymx.Y, jx.Z+ymx.Z), boris, nw)
	EWWStep(x, y, z, cur, prv, 2, csq, omW, math32.Vec3(jy.X+ymy.X, jy.Y+ymy.Y, jy.Z+ymy.Z), boris, nw)
	EWWStep(x, y, z, cur, prv, 3, csq, omW, math32.Vec3(jz.X+ymz.X, jz.Y+ymz.Y, jz.Z+ymz.Z), boris, nw)
	EWGaugeStep(x, y, z, cur, prv, int32(EWB0s), csq, j0.W, jx.W, jy.W, jz.W, nw)

	// ---- Higgs update ------------------------------------------------------
	var hvN math32.Vector4
	if boris {
		hh := hf.MulScalar(0.5)
		hvN = EWBorisPhase(w10, w20, w30, b0, 2*Params[0].C, psv.Add(hh)).Add(hh)
	} else {
		hvN = psv.Add(hf)
	}
	hvCaN := hvN.X
	hvCbN := hvN.Y
	hv0aN := hvN.Z
	hv0bN := hvN.W

	State[z, y, x, EWHsCa, cur] = psi.X + hvCaN
	State[z, y, x, EWHsCb, cur] = psi.Y + hvCbN
	State[z, y, x, EWHs0a, cur] = psi.Z + hv0aN
	State[z, y, x, EWHs0b, cur] = psi.W + hv0bN

	State[z, y, x, EWHvCa, cur] = hvCaN
	State[z, y, x, EWHvCb, cur] = hvCbN
	State[z, y, x, EWHv0a, cur] = hv0aN
	State[z, y, x, EWHv0b, cur] = hv0bN

	// ---- mass-eigenstate views ---------------------------------------------
	// Rotate the freshly-updated (W^3, B) pair through the weak mixing angle.
	// The photon goes into the ordinary Maxwell variables: it IS the
	// electromagnetic field, so A0s..AZs is where it belongs. Nothing here is
	// evolved -- these are recomputed from the gauge basis every step, which is
	// why StepRun must NOT also run MaxwellKernel in Electroweak mode.
	sw := Params[0].SinThetaW
	cw := Params[0].CosThetaW
	for k := range 4 {
		ki := int32(k)
		w3s := State[z, y, x, int32(EWW30s)+ki, cur]
		w3v := State[z, y, x, int32(EWW30v)+ki, cur]
		bs := State[z, y, x, int32(EWB0s)+ki, cur]
		bv := State[z, y, x, int32(EWB0v)+ki, cur]
		State[z, y, x, int32(A0s)+ki, cur] = sw*w3s + cw*bs
		State[z, y, x, int32(A0v)+ki, cur] = sw*w3v + cw*bv
		State[z, y, x, int32(EWZ0)+ki, cur] = cw*w3s - sw*bs

		w1s := State[z, y, x, int32(EWW10s)+ki, cur]
		w2s := State[z, y, x, int32(EWW20s)+ki, cur]
		State[z, y, x, int32(EWWPr0)+ki, cur] = w1s * InvSqrt2
		State[z, y, x, int32(EWWPi0)+ki, cur] = -w2s * InvSqrt2
	}
	wm := float32(0)
	for k := range 4 {
		ki := int32(k)
		w1s := State[z, y, x, int32(EWW10s)+ki, cur]
		w2s := State[z, y, x, int32(EWW20s)+ki, cur]
		wm += 0.5 * (w1s*w1s + w2s*w2s)
	}
	State[z, y, x, EWWMag, cur] = wm

	State[z, y, x, EWHmag, cur] = mag
	State[z, y, x, EWHV, cur] = -0.5*musq*mag + 0.25*lambda*mag*mag
}

// EWWStep advances the twelve SU(2) potentials. src carries the
// velocity-INDEPENDENT source (current + the explicit Yang-Mills terms) for one
// spacetime index, as an adjoint 3-vector; the Laplacian is added here.
//
// With Boris on, the velocity-dependent transport term -- which is exactly
// dv/dt = v x Omega with Omega = -2 g c W_0 -- is applied as a true rotation
// between two half kicks, instead of being lumped into the explicit force.
func EWWStep(x, y, z, cur, prv, nu int32, csq float32, om, src math32.Vector3, boris, noWave bool) {
	vs := int32(EWW10s) + nu
	vv := int32(EWW10v) + nu
	p1 := State[z, y, x, vs, prv]
	p2 := State[z, y, x, vs+8, prv]
	p3 := State[z, y, x, vs+16, prv]
	l1 := Laplacian19(x, y, z, vs, prv, p1)
	l2 := Laplacian19(x, y, z, vs+8, prv, p2)
	l3 := Laplacian19(x, y, z, vs+16, prv, p3)
	f := math32.Vec3(csq*(l1+src.X), csq*(l2+src.Y), csq*(l3+src.Z))
	q1 := State[z, y, x, vv, prv]
	q2 := State[z, y, x, vv+8, prv]
	q3 := State[z, y, x, vv+16, prv]
	v := math32.Vec3(q1, q2, q3)
	var vn math32.Vector3
	if noWave && nu == 0 {
		// Params.A0NoWave: drive the SCALAR potential straight from the force
		// rather than accumulating it into a velocity. The nu = 0 sector is the
		// gauge direction, whose linearised system has a degenerate eigenvalue
		// and so carries a secular (A + B t) branch -- it drifts without bound
		// even though the physics does not. Dropping its wave dynamics is the
		// same Sommerfeld-style fix MaxwellKernel already uses for A0.
		vn = f
	} else if boris {
		h := f.MulScalar(0.5)
		vn = EWBorisRot3(v.Add(h), om).Add(h)
	} else {
		vn = v.Add(f)
	}
	State[z, y, x, vv, cur] = vn.X
	State[z, y, x, vv+8, cur] = vn.Y
	State[z, y, x, vv+16, cur] = vn.Z
	State[z, y, x, vs, cur] = p1 + vn.X
	State[z, y, x, vs+8, cur] = p2 + vn.Y
	State[z, y, x, vs+16, cur] = p3 + vn.Z
}

// EWGaugeStep advances one four-potential (the 0,X,Y,Z state variables
// starting at v0, with their four velocities at v0+4) by one leapfrog step of
//
//	d2 A_mu / dt2 = c^2 [ lap(A_mu) + j_mu ]
//
// which is box A_mu = j_mu in Lorenz gauge -- the same equation MaxwellKernel
// solves for the photon, with the electroweak current in place of the
// electromagnetic one. No mass term appears here or anywhere else.
func EWGaugeStep(x, y, z, cur, prv, v0 int32, csq, j0, jx, jy, jz float32, noWave bool) {
	for ki := range 4 {
		k := int32(ki)
		vs := v0 + k
		vv := v0 + 4 + k
		var jc float32
		switch ki {
		case 0:
			jc = j0
		case 1:
			jc = jx
		case 2:
			jc = jy
		default:
			jc = jz
		}
		ps := State[z, y, x, vs, prv]
		vp := State[z, y, x, vv, prv]
		f := csq * (Laplacian19(x, y, z, vs, prv, ps) + jc)
		vc := vp + f
		if noWave && ki == 0 {
			vc = f // see EWWStep: the scalar potential is the gauge direction
		}
		State[z, y, x, vv, cur] = vc
		State[z, y, x, vs, cur] = ps + vc
	}
}

//gosl:end

func (ss *Sim) ElectroweakConfig() {
	ParamsShouldDisplay = ElectroweakDisplay
	ss.StateVars = EWStatesN
	ss.initFuncs = ElectroweakConfigs
	ss.InitFunc = HiggsBroken
	ss.Config.Wavelength = 16
	ss.Config.PacketWidth = 1.5 * ss.Config.Wavelength
	ss.ViewInit(func(view *View) {
		view.SetVar(EWHs0a, -1)
	})
}

// ElectroweakViewAll configures the View to display Electroweak values
func ElectroweakViewAll(view *View) {
	view.Settings.NPanels = PanelsFour
	view.Settings.Camera = 2
	view.Settings.Height = 0.8
	view.Panels[0].Var = EWHs0a
	view.Panels[1].Var = AYs // the transverse component: A0s is zero for a pulse
	// view.SetCurPrev(Previous, 1)
	view.Panels[2].Var = EWBYs
	// view.SetCurPrev(Previous, 3)
	view.Panels[3].Var = EWW3Ys
	// view.Settings.TrackParticle = 0
}

// ElectroweakStats adds the stats plotted over time in the GUI. Each one is a
// full pass over the state, so at 100^3 they are not free: raise
// Config.ViewInterval if the run drags.
func (ss *Sim) ElectroweakStats() {
	ss.AddStat(ss.StatStep())
	ss.AddStat(ss.StatMean(EWHmag)) // directly comparable to v^2
	ss.AddStat(ss.StatSum(EWHV))
	// the pulse configs: photon vs Z, and the two fields they are mixed from.
	// The photon runs at ~c and the Z visibly slower, while W^3 and B each show
	// whichever of the two they currently carry.
	ss.AddStat(ss.StatGroupVel(math32.X, AYs, EWZY, EWBYs, EWW3Ys))
	// W collision: W^3 generated out of nothing by the non-abelian coupling.
	ss.AddStat(ss.StatSumSq(EWW3SqStat, EWW30s, EWW3Xs, EWW3Ys, EWW3Zs))
	// what a Z packet does to the condensate it travels through.
	ss.AddStat(ss.StatWeightedMean(EWHmagZStat, EWHmag, EWZY))
}

// Stat names that are not built from a variable and a dimension.
const (
	// EWW3SqStat is the summed squares of all four W^3 components.
	EWW3SqStat = "W3Sq"

	// EWHmagZStat is |Phi|^2 weighted by the local Z intensity.
	EWHmagZStat = "HmagZ"
)

// ElectroweakDisplay determines which Parameters fields to display.
var ElectroweakDisplay = []string{"Edges", "Energy", "C", "Hbar", "Mass", "A0NoWave", "E", "Mu0", "HiggsMu", "HiggsLambda", "Temp", "ThermalC", "GW", "GpW", "YangMills", "Boris", "TempCrit", "HiggsV", "MW", "MZ"}

//////// initialization helpers

// ewFreq returns the lattice angular frequency in radians per step, for a
// gauge wave of given carrier wavelength and mass, both in cube units:
//
//	omega = c sqrt(khat^2 + m^2),  khat = 2 sin(k/2)
//
// khat, not k: that is what the discrete Laplacian sees. Using k mistunes the
// packet and leaves a backward-moving remnant.
func ewFreq(ss *Sim, wavelength, mass float32) float32 {
	k := TwoPi / wavelength
	khat := 2 * math32.Sin(k/2)
	return ss.Params.C * math32.Sqrt(khat*khat+mass*mass)
}

// ewDemoScale raises the electroweak scale so m_W and m_Z are comparable to a
// packet a few tens of cubes long. At the SM scale the boson Compton
// wavelengths are ~22 cubes, so a visible packet is far above threshold and the
// Z would run at 0.97 c. g and g' are untouched, so the mixing angle and
// m_W / m_Z stay physical.
func ewDemoScale(ss *Sim, mu float32) {
	ss.Params.HiggsMu = mu
	ss.Params.Update()
}

// ewVZero returns the zero-temperature vacuum value, mu/sqrt(lambda): still
// the natural amplitude scale when Temp has driven HiggsV to zero.
func ewVZero(ss *Sim) float32 {
	p := ss.Params
	if p.HiggsLambda <= 0 {
		return 0
	}
	return p.HiggsMu / math32.Sqrt(p.HiggsLambda)
}

//////// configurations

// HiggsBroken initializes the vacuum is <Phi> = (0, v/sqrt2)^T, i.e.
// the NEUTRAL (lower) component holds the VEV, with magnitude
// v = mu/sqrt(lambda) -- not mu. Putting it
// in the charged component instead would leave Q = T^3 + Y broken
// and give the photon a mass.
func HiggsBroken(ss *Sim) {
	ss.Fill(EWHs0a, Both, ss.Params.HiggsV)
}

// HiggsSymmetric starts every Higgs component at zero plus a whisper of noise,
// and lets the field fall off the top of the Mexican hat into the broken vacuum.
// Any deviation of \Phi off of 0 is enough to knock it off of the unstable maximum.
//
// Adjusting Temp around TempCrit changes the shape of the potential: if above
// TempCrit then it is symmetric and the zero remains stable, not unstable.
//
// EWHmag climbs from 0 to v^2, but overshoots and rings rather than settling,
// because nothing here dissipates. In the early universe Hubble
// expansion drained it, and there is no equivalent in a fixed box.
// Note: it takes a while, around 700 time steps at default params.
func HiggsSymmetric(ss *Sim) {
	amp := 0.02 * ewVZero(ss)
	ss.SmoothNoise(EWHsCa, amp, 6)
	ss.SmoothNoise(EWHsCb, amp, 6)
	ss.SmoothNoise(EWHs0a, amp, 6)
	ss.SmoothNoise(EWHs0b, amp, 6)
}

// PhotonPulse sends a transverse electromagnetic pulse along X at exactly the
// speed of light.
//
// The packet is written in the PHYSICAL basis: the photon is the combination
// sin(theta_W) W^3 + cos(theta_W) B, the direction that Q = T^3 + Y annihilates,
// so the condensate gives it no mass and it moves at c. Watch AYs.
func PhotonPulse(ss *Sim) {
	HiggsBroken(ss)
	p := ss.Params
	wl := ss.Config.Wavelength
	om := ewFreq(ss, wl, 0) // massless
	cx := float32(ss.Config.Size.X) * 0.2
	// the weights are the photon direction itself; Config.Amplitude sets the size
	ss.SlabPacketConfig(EWW3Ys, EWW3Yv, math32.X, cx, p.SinThetaW, 1, om)
	ss.SlabPacketConfig(EWBYs, EWBYv, math32.X, cx, p.CosThetaW, 1, om)
}

// ZPulse sends a Z boson pulse along X, which travels SLOWER than light.
// Because Z is cos(theta_W) W^3 - sin(theta_W) B, that direction does not
// annihilate the vacuum, so it takes mass m_Z from the condensate and the
// packet moves at the group velocity:
//
//	v_g = c khat / sqrt(khat^2 + m_Z^2)
//
// which would be about 0.70 c here, vs 0.98 c for the photon. Watch ZY.
// With the default [Config.Amplitude] of 1, it melts the condensate it
// passes through to about a third of vacuum, and a lighter Z travels faster.
//
// Note this raises the Higgs scale, for the reason given in ewDemoScale.
func ZPulse(ss *Sim) {
	ewDemoScale(ss, 0.388)
	HiggsBroken(ss)
	p := ss.Params
	wl := ss.Config.Wavelength
	om := ewFreq(ss, wl, p.MZ)
	cx := float32(ss.Config.Size.X) * 0.2
	// the weights are the Z direction itself; Config.Amplitude sets the size
	ss.SlabPacketConfig(EWW3Ys, EWW3Yv, math32.X, cx, p.CosThetaW, 1, om)
	ss.SlabPacketConfig(EWBYs, EWBYv, math32.X, cx, -p.SinThetaW, 1, om)
}

// WCollision fires two W packets at each other. They do not bounce -- gauge
// fields pass through each other -- but the Yang-Mills eps^abc W^b W^c term
// means a W^1 and a W^2 generate W^3 where they overlap, out of nothing. Turn
// off Params.YangMills and they cross without a trace: that is the whole
// difference between SU(2) and three copies of U(1).
//
// Watch W3Xs, and ZX built from it. X, not Y: both packets are polarised along
// Y and travel along X, so W^{b mu} d_mu vanishes and the transport term is
// silent. The surviving transpose term sources the LONGITUDINAL W^3_x, which
// for a massive vector is physical -- the eaten Goldstone. A single packet
// generates exactly zero. With wrapped edges the pair re-collides every lap,
// so the signal accumulates rather than peaking.
//
// The envelope width is set here rather than from Config.PacketWidth: the
// packets start 40% of the box apart, and the 1.5 wl default has them already
// overlapping at half amplitude. On a 100-wide box 1.5 wl gives 50% overlap at
// t=0, 1.2 wl 34%, 0.75 wl 6% -- the first that looks like a collision. The
// large amplitude pays for that: the source is quadratic in W, so 0.1 v ->
// 0.25 v wins back 6x of the 260x the narrower envelope costs.
func WCollision(ss *Sim) {
	ewDemoScale(ss, 0.388)
	HiggsBroken(ss)
	p := ss.Params
	wl := ss.Config.Wavelength
	om := ewFreq(ss, wl, p.MW)
	amp := 0.25 * p.HiggsV * ss.Config.Amplitude
	xl := float32(ss.Config.Size.X)
	ss.SlabPacket(EWW1Ys, EWW1Yv, math32.X, xl*0.3, wl, 0.75*wl, amp, 1, om)
	ss.SlabPacket(EWW2Ys, EWW2Yv, math32.X, xl*0.7, wl, 0.75*wl, amp, -1, om)
}

var ElectroweakConfigs = []InitFunc{
	InitFunc{Name: "Higgs Broken", Doc: "Broken symmetry with Higgs field (Hs0a) at vacuum expectation value", Func: HiggsBroken, Current: true},
	InitFunc{Name: "Higgs Symmetric", Doc: "Higgs starts at zero plus noise and falls off the top of the Mexican hat; watch Hmag climb to v^2 and ring", Func: HiggsSymmetric},
	InitFunc{Name: "Photon Pulse", Doc: "Transverse EM pulse travelling along X at exactly c; watch AYs", Func: PhotonPulse},
	InitFunc{Name: "Z Pulse", Doc: "Z boson pulse along X at about 0.75 c, slower than light because the condensate gives it mass; watch ZY", Func: ZPulse},
	InitFunc{Name: "W Collision", Doc: "Two W packets cross and generate longitudinal W^3 where they overlap: the non-abelian eps^abc coupling in action; watch W3Xs and ZX", Func: WCollision},
}
