package wavesim

import "cogentcore.org/core/math32"

//gosl:start

// NParticles is the total number of particles that can be tracked.
const NParticles = 4

// ParticleVars are the particle variables to record.
type ParticleVars int32 //enums:enum -trim-prefix=Particle

const (
	// ParticleType is the type or ID of the particle
	ParticleType ParticleVars = iota

	// ParticleMass is the rest mass of the particle.
	ParticleMass

	// Position
	ParticlePosX
	ParticlePosY
	ParticlePosZ

	// Velocity
	ParticleVelX
	ParticleVelY
	ParticleVelZ

	// ParticleLorentz is the Lorentz factor.
	ParticleLorentz

	// ParticleESq is the squared energy of the particle.
	ParticleESq
)

// SetParticleAt sets particle dynamic data at given index.
func SetParticleAt(idx int32, lorentz, esq float32, pos math32.Vector3i, vel math32.Vector3) {
	Particles[idx, ParticleLorentz] = lorentz
	Particles[idx, ParticleESq] = esq
	Particles[idx, ParticlePosX] = float32(pos.X)
	Particles[idx, ParticlePosY] = float32(pos.Y)
	Particles[idx, ParticlePosZ] = float32(pos.Z)
}

// GetParticleAt gets particle dynamic data at given index.
func GetParticleAt(idx int32) (lorentz, esq float32, pos math32.Vector3i, vel math32.Vector3) {
	lorentz = Particles[idx, ParticleLorentz]
	esq = Particles[idx, ParticleESq]
	pos.X = int32(Particles[idx, ParticlePosX])
	pos.Y = int32(Particles[idx, ParticlePosY])
	pos.Z = int32(Particles[idx, ParticlePosZ])
	return
}

func (ss *Sim) ParticleStats() {
	ss.AddStat(ss.StatStep())
	ss.AddStat(ss.StatParticle(0))
}

//gosl:end
