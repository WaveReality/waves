package wavesim

import (
	"cogentcore.org/core/math32"
	"cogentcore.org/lab/gosl/slmath"
)

//gosl:start
//gosl:import "cogentcore.org/lab/gosl/slmath"

// EWStates are the state variables for the Electroweak Model.
type EWStates EMStates //enums:enum -trim-prefix=EW

const (
	// EWHsCa is the Higgs doublet charged state Ca (real)
	EWHsCa EWStates = EWStates(EMStatesN) + iota

	// EWHsCb is the Higgs doublet charged state Cb (imaginary)
	EWHsCb

	// EWHs0a is the Higgs doublet neutral state 0a (real)
	EWHs0a

	// EWHs0b is the Higgs doublet neutral state 0b (imaginary)
	EWHs0b

	// EWHvCa is the Higgs doublet charged vel 0a (real)
	EWHvCa

	// EWHvCb is the Higgs doublet charged vel 0b (imaginary)
	EWHvCb

	// EWHv0a is the Higgs doublet neutral vel 0a (real)
	EWHv0a

	// EWHv0b is the Higgs doublet neutral vel 0b (imaginary)
	EWHv0b

	// EWHmag is the Higgs magnitude (h.c. * state = squared magnitude)
	EWHmag

	// EWV is the Higgs potential as a function of Hmag
	EWHV

	// EWB0s is the B weak hypercharge scalar potential 0 component.
	EWB0s

	// EWBXs is the B weak hypercharge vector potential X component.
	EWBXs

	// EWBYs is the B weak hypercharge vector potential Y component.
	EWBYs

	// EWBZs is the B weak hypercharge vector potential Z component.
	EWBZs

	// EWB0v is the B weak hypercharge scalar potential 0 velocity.
	EWB0v

	// EWBXv is the B weak hypercharge vector potential X velocity.
	EWBXv

	// EWBYv is the B weak hypercharge vector potential Y velocity.
	EWBYv

	// EWBZv is the B weak hypercharge vector potential Z velocity.
	EWBZv

	// EWW10s is the W weak isospin 1 scalar potential 0 component.
	EWW10s

	// EWW1Xs is the W weak isospin 1 vector potential X component.
	EWW1Xs

	// EWW1Ys is the W weak isospin 1 vector potential Y component.
	EWW1Ys

	// EWW1Zs is the W weak isospin 1 vector potential Z component.
	EWW1Zs

	// EWW10v is the W weak isospin 1 scalar potential 0 velocity.
	EWW10v

	// EWW1Xv is the W weak isospin 1 vector potential X velocity.
	EWW1Xv

	// EWW1Yv is the W weak isospin 1 vector potential Y velocity.
	EWW1Yv

	// EWW1Zv is the W weak isospin 1 vector potential Z velocity.
	EWW1Zv

	// EWW20s is the W weak isospin 2 scalar potential 0 component.
	EWW20s

	// EWW2Xs is the W weak isospin 2 vector potential X component.
	EWW2Xs

	// EWW2Ys is the W weak isospin 2 vector potential Y component.
	EWW2Ys

	// EWW2Zs is the W weak isospin 2 vector potential Z component.
	EWW2Zs

	// EWW20v is the W weak isospin 2 scalar potential 0 velocity.
	EWW20v

	// EWW2Xv is the W weak isospin 2 vector potential X velocity.
	EWW2Xv

	// EWW2Yv is the W weak isospin 2 vector potential Y velocity.
	EWW2Yv

	// EWW2Zv is the W weak isospin 2 vector potential Z velocity.
	EWW2Zv

	// EWW30s is the W weak isospin 3 scalar potential 0 component.
	EWW30s

	// EWW3Xs is the W weak isospin 3 vector potential X component.
	EWW3Xs

	// EWW3Ys is the W weak isospin 3 vector potential Y component.
	EWW3Ys

	// EWW3Zs is the W weak isospin 3 vector potential Z component.
	EWW3Zs

	// EWW30v is the W weak isospin 3 scalar potential 0 velocity.
	EWW30v

	// EWW3Xv is the W weak isospin 3 vector potential X velocity.
	EWW3Xv

	// EWW3Yv is the W weak isospin 3 vector potential Y velocity.
	EWW3Yv

	// EWW3Zv is the W weak isospin 3 vector potential Z velocity.
	EWW3Zv
)

// YPhi is the weak hypercharge of the Higgs doublet in the Q = T^3 + Y
// convention. Together with T^3 = -1/2 for the lower component this makes
// Q = 0 there, so the photon does not couple to the vacuum and stays massless.
const YPhi = 0.5

// EWGaugeAct returns -i * G * Psi in real components, where G is the Hermitian
// 2x2 gauge matrix that the covariant derivative is built from:
//
//	G = g W^a T^a + g' Y_Phi B,   T^a = sigma^a / 2
//	  = [[ du, or + i oi ], [ or - i oi, dd ]]
//	du = (g/2) W3 + g' Y B      or = (g/2) W1
//	dd = -(g/2) W3 + g' Y B     oi = -(g/2) W2
//
// The opposite sign of W3 on the two diagonal entries is T^3 = +-1/2, and it
// is the whole reason the upper and lower doublet components feel W3
// oppositely while feeling B identically. Solving for the combination that
// annihilates the vacuum is what picks out Q = T^3 + Y and leaves one
// massless direction.
//
// This single operation is the entire content of the gauge coupling. The
// covariant derivative is
//
//	D_mu Psi = d_mu Psi + EWGaugeAct(W_mu, B_mu, Psi)
//
// and the covariant Laplacian composes out of it (see the kernel).
//
// Psi is the doublet written as four real fields,
// Psi = (X + iY, Z + iW) = sqrt(2) Phi, so Phi^dag Phi = |Psi|^2 / 2.
func EWGaugeAct(w1, w2, w3, b float32, psi math32.Vector4) math32.Vector4 {
	hg := 0.5 * Params[0].GW
	gy := Params[0].GpW * YPhi
	du := hg*w3 + gy*b
	dd := -hg*w3 + gy*b
	or := hg * w1
	oi := -hg * w2
	var o math32.Vector4
	o.X = du*psi.Y + or*psi.W + oi*psi.Z
	o.Y = -(du*psi.X + or*psi.Z - oi*psi.W)
	o.Z = or*psi.Y - oi*psi.X + dd*psi.W
	o.W = -(or*psi.X + oi*psi.Y + dd*psi.Z)
	return o
}

// EWCurrent returns the four gauge currents that a doublet Psi with covariant
// derivative d = D_mu Psi puts into the gauge fields at spacetime index mu:
//
//	X,Y,Z = j^a_mu = 2 g  Im[Phi^dag T^a D_mu Phi]   (a = 1,2,3, sourcing W^a)
//	W     = j^Y_mu = 2 g' Y Im[Phi^dag D_mu Phi]     (sourcing B)
//
// with Phi = Psi/sqrt(2) folding one factor of 1/2 into each expression.
//
// NOTHING in this kernel contains a gauge boson mass term. The masses arise
// because Psi is non-zero everywhere: evaluated at the vacuum this current
// reduces to exactly -m^2 times the gauge field itself, uniformly and
// permanently. That feedback is the Higgs mechanism.
func EWCurrent(psi, d math32.Vector4) math32.Vector4 {
	hg := 0.5 * Params[0].GW
	gy := Params[0].GpW * YPhi
	var j math32.Vector4
	j.X = hg * ((psi.X*d.W - psi.Y*d.Z) + (psi.Z*d.Y - psi.W*d.X))
	j.Y = hg * (-(psi.X*d.Z + psi.Y*d.W) + (psi.Z*d.X + psi.W*d.Y))
	j.Z = hg * ((psi.X*d.Y - psi.Y*d.X) - (psi.Z*d.W - psi.W*d.Z))
	j.W = gy * ((psi.X*d.Y - psi.Y*d.X) + (psi.Z*d.W - psi.W*d.Z))
	return j
}

// EWDiv returns the lattice divergence of a 3-vector gauge potential whose
// X, Y, Z components are the three consecutive state variables at vX.
func EWDiv(x, y, z, vX, tidx int32) float32 {
	gx := Gradient10(x, y, z, vX, tidx)
	gy := Gradient10(x, y, z, vX+1, tidx)
	gz := Gradient10(x, y, z, vX+2, tidx)
	return gx.X + gy.Y + gz.Z
}

// EWCrossUp returns sum_mu (A^mu x B_mu), the contraction of an UPPER with a
// LOWER spacetime index. No metric signs: all four terms add.
//
// Every eps^{abc} in the Yang-Mills equation is a cross product in adjoint
// space, since eps^{abc} X^b Y^c = (X x Y)^a. Writing the self-coupling this
// way turns a triple-index mess into four cross products.
func EWCrossUp(a0, ax, ay, az, b0, bx, by, bz math32.Vector3) math32.Vector3 {
	r := slmath.Cross3(a0, b0)
	r = r.Add(slmath.Cross3(ax, bx))
	r = r.Add(slmath.Cross3(ay, by))
	r = r.Add(slmath.Cross3(az, bz))
	return r
}

// EWCrossLor returns sum_mu (A_mu x B^mu) where BOTH carry the same index
// position, so the (+,-,-,-) metric appears: time adds, space subtracts.
func EWCrossLor(a0, ax, ay, az, b0, bx, by, bz math32.Vector3) math32.Vector3 {
	r := slmath.Cross3(a0, b0)
	r = r.Sub(slmath.Cross3(ax, bx))
	r = r.Sub(slmath.Cross3(ay, by))
	r = r.Sub(slmath.Cross3(az, bz))
	return r
}

// ElectroweakKernel is the kernel for the SU(2)_L x U(1)_Y electroweak model:
// the Higgs doublet coupled to the three W^a gauge fields and the B field.
// Only supports 3D.
//
// # Fields
//
// The Higgs doublet is carried as four real fields,
//
//	Phi = (1/sqrt2) ( hsCa + i hsCb , hs0a + i hs0b )^T
//
// so mag = hsCa^2 + hsCb^2 + hs0a^2 + hs0b^2 = 2 Phi^dag Phi. The vacuum
// <Phi> = (0, v/sqrt2)^T is hs0a = v with the other three zero. It MUST be the
// neutral (lower) component: that is what makes Q = T^3 + Y annihilate the
// vacuum and leaves the photon massless.
//
// Each gauge field is a four-potential (0, X, Y, Z) with its own velocity,
// exactly as in MaxwellKernel, and is evolved in Lorenz gauge where the
// equation of motion is simply
//
//	box W^a_mu = j^a_mu,    box B_mu = j^Y_mu
//
// # Units
//
// Everything is in inverse cube units (1/cube). That is what makes g, g' and
// lambda the bare dimensionless Standard Model numbers, needing no conversion
// (see Units.Update).
//
// # Yang-Mills self-coupling
//
// Enabled by Params.YangMills. With a Feynman-type gauge-fixing term (xi = 1)
// cancelling the -d^nu(d.W) piece, the non-abelian equation of motion is
//
//	box W^a_nu = j^a_nu
//	             + g eps^abc (d.W^b) W^c_nu                  [divergence]
//	             + 2g eps^abc W^{b mu} d_mu W^c_nu           [transport]
//	             - g eps^abc W^b_mu d^nu W^{c mu}            [transpose]
//	             - g^2 eps^abc eps^cde (W^b.W^d) W^e_nu      [quartic]
//
// The three CUBIC signs are fixed by requiring the force to be -dU/dphi for the
// standard energy with F^a_jk = d_j W^a_k - d_k W^a_j + g eps^abc W^b_j W^c_k;
// see TestElectroweakForceIsEnergyGradient. They cannot be fixed by the
// pure-gauge test alone, because flipping them also reverses the rotation sense
// it predicts, so that test passes either way. The quartic sign is independent
// and is checked exactly on uniform fields.
//
// Note the divergence term is kept rather than dropped: unlike the abelian
// case, d.W^a = 0 is NOT preserved by the non-abelian evolution, so it cannot
// simply be imposed.
//
// Every term is quadratic or cubic in W, so all four vanish identically at
// linear order and the boson spectrum is unchanged -- TestGaugeBosonMasses
// passes with this on or off. What they add is the W self-interaction, i.e.
// the difference between genuine SU(2) and three independent copies of U(1).
//
func ElectroweakKernel(i uint32) { //gosl:kernel
	ctx := GetCtx(0)
	var x, y, z int32
	ok := ctx.StateCoords(i, &x, &y, &z)
	if !ok {
		return
	}
	cur := ctx.CurState
	prv := ctx.PrevState()
	csq := Params[0].CSq
	oc := 1.0 / Params[0].C
	musq := Params[0].HiggsMuSq
	lambda := Params[0].HiggsLambda

	// ---- Higgs doublet and its velocity ----------------------------------
	psi := math32.Vec4(State[z, y, x, EWHsCa, prv], State[z, y, x, EWHsCb, prv],
		State[z, y, x, EWHs0a, prv], State[z, y, x, EWHs0b, prv])
	psv := math32.Vec4(State[z, y, x, EWHvCa, prv], State[z, y, x, EWHvCb, prv],
		State[z, y, x, EWHv0a, prv], State[z, y, x, EWHv0b, prv])

	// ---- gauge potentials, per spacetime index ---------------------------
	w10 := State[z, y, x, EWW10s, prv]
	w1x := State[z, y, x, EWW1Xs, prv]
	w1y := State[z, y, x, EWW1Ys, prv]
	w1z := State[z, y, x, EWW1Zs, prv]
	w20 := State[z, y, x, EWW20s, prv]
	w2x := State[z, y, x, EWW2Xs, prv]
	w2y := State[z, y, x, EWW2Ys, prv]
	w2z := State[z, y, x, EWW2Zs, prv]
	w30 := State[z, y, x, EWW30s, prv]
	w3x := State[z, y, x, EWW3Xs, prv]
	w3y := State[z, y, x, EWW3Ys, prv]
	w3z := State[z, y, x, EWW3Zs, prv]
	b0 := State[z, y, x, EWB0s, prv]
	bx := State[z, y, x, EWBXs, prv]
	by := State[z, y, x, EWBYs, prv]
	bz := State[z, y, x, EWBZs, prv]

	// ---- ordinary gradients of the four Higgs components -----------------
	gCa := Gradient10(x, y, z, int32(EWHsCa), prv)
	gCb := Gradient10(x, y, z, int32(EWHsCb), prv)
	g0a := Gradient10(x, y, z, int32(EWHs0a), prv)
	g0b := Gradient10(x, y, z, int32(EWHs0b), prv)

	dxp := math32.Vec4(gCa.X, gCb.X, g0a.X, g0b.X) // d_x Psi
	dyp := math32.Vec4(gCa.Y, gCb.Y, g0a.Y, g0b.Y)
	dzp := math32.Vec4(gCa.Z, gCb.Z, g0a.Z, g0b.Z)

	// ---- covariant derivatives D_mu Psi = d_mu Psi - i G_mu Psi ----------
	ax := EWGaugeAct(w1x, w2x, w3x, bx, psi)
	ay := EWGaugeAct(w1y, w2y, w3y, by, psi)
	az := EWGaugeAct(w1z, w2z, w3z, bz, psi)
	a0 := EWGaugeAct(w10, w20, w30, b0, psi)

	dX := dxp.Add(ax)
	dY := dyp.Add(ay)
	dZ := dzp.Add(az)
	// the time component: velocities are per step and c is cubes per step, so
	// psv/c is d_0 Psi in the same 1/cube units as the spatial gradients.
	dtp := math32.Vec4(oc*psv.X, oc*psv.Y, oc*psv.Z, oc*psv.W)
	d0 := dtp.Add(a0)

	// ---- covariant Laplacian ---------------------------------------------
	// D_j D_j Psi = d_j(D_j Psi) - i G_j (D_j Psi)
	//             = lap(Psi) - i(d_j G_j)Psi - i G_j d_j Psi - i G_j D_j Psi
	// Each -i G ... piece is just EWGaugeAct applied to a different argument,
	// so the whole covariant Laplacian composes out of the one operation.
	// Spatial gradients of all twelve W components. These serve double duty:
	// their traces give the divergences the Higgs covariant Laplacian needs,
	// and the full tensor is what the Yang-Mills self-coupling runs on.
	g10 := Gradient10(x, y, z, int32(EWW10s), prv)
	g1x := Gradient10(x, y, z, int32(EWW1Xs), prv)
	g1y := Gradient10(x, y, z, int32(EWW1Ys), prv)
	g1z := Gradient10(x, y, z, int32(EWW1Zs), prv)
	g20 := Gradient10(x, y, z, int32(EWW20s), prv)
	g2x := Gradient10(x, y, z, int32(EWW2Xs), prv)
	g2y := Gradient10(x, y, z, int32(EWW2Ys), prv)
	g2z := Gradient10(x, y, z, int32(EWW2Zs), prv)
	g30 := Gradient10(x, y, z, int32(EWW30s), prv)
	g3x := Gradient10(x, y, z, int32(EWW3Xs), prv)
	g3y := Gradient10(x, y, z, int32(EWW3Ys), prv)
	g3z := Gradient10(x, y, z, int32(EWW3Zs), prv)

	dvW1 := g1x.X + g1y.Y + g1z.Z
	dvW2 := g2x.X + g2y.Y + g2z.Z
	dvW3 := g3x.X + g3y.Y + g3z.Z
	dvB := EWDiv(x, y, z, int32(EWBXs), prv)

	lap := math32.Vec4(Laplacian19(x, y, z, int32(EWHsCa), prv, psi.X),
		Laplacian19(x, y, z, int32(EWHsCb), prv, psi.Y),
		Laplacian19(x, y, z, int32(EWHs0a), prv, psi.Z),
		Laplacian19(x, y, z, int32(EWHs0b), prv, psi.W))

	cov := lap.Add(EWGaugeAct(dvW1, dvW2, dvW3, dvB, psi))
	cov = cov.Add(EWGaugeAct(w1x, w2x, w3x, bx, dxp.Add(dX)))
	cov = cov.Add(EWGaugeAct(w1y, w2y, w3y, by, dyp.Add(dY)))
	cov = cov.Add(EWGaugeAct(w1z, w2z, w3z, bz, dzp.Add(dZ)))

	// ---- time-component gauge terms ---------------------------------------
	// D_0 D_0 Psi expands exactly as the spatial case does:
	//
	//	D_0D_0 Psi = (1/c^2) d_t^2 Psi + (1/c)(d_t G_0) Psi
	//	             + (1/c) G_0 d_t Psi + G_0 D_0 Psi
	//
	// and the equation of motion is D_0D_0 = vfac + D_jD_j, so solving it for
	// the acceleration SUBTRACTS the last three. Without these the Higgs
	// sources W_0 and B_0 through j_0 but never feels them back, which breaks
	// gauge invariance: a constant A_0 is pure gauge and must produce a phase
	// rotation at constant |Phi|, not a change in the magnitude.
	w1xv := State[z, y, x, EWW1Xv, prv]
	w1yv := State[z, y, x, EWW1Yv, prv]
	w1zv := State[z, y, x, EWW1Zv, prv]
	w2xv := State[z, y, x, EWW2Xv, prv]
	w2yv := State[z, y, x, EWW2Yv, prv]
	w2zv := State[z, y, x, EWW2Zv, prv]
	w3xv := State[z, y, x, EWW3Xv, prv]
	w3yv := State[z, y, x, EWW3Yv, prv]
	w3zv := State[z, y, x, EWW3Zv, prv]
	w10v := State[z, y, x, EWW10v, prv]
	w20v := State[z, y, x, EWW20v, prv]
	w30v := State[z, y, x, EWW30v, prv]
	b0v := State[z, y, x, EWB0v, prv]

	q0 := EWGaugeAct(oc*w10v, oc*w20v, oc*w30v, oc*b0v, psi)
	q1 := EWGaugeAct(w10, w20, w30, b0, dtp)
	q2 := EWGaugeAct(w10, w20, w30, b0, d0)
	cov = math32.Vec4(cov.X-q0.X-q1.X-q2.X, cov.Y-q0.Y-q1.Y-q2.Y,
		cov.Z-q0.Z-q1.Z-q2.Z, cov.W-q0.W-q1.W-q2.W)

	// ---- the potential ----------------------------------------------------
	// V = -(1/2) mu^2 mag + (1/4) lambda mag^2
	// force_i = -dV/dphi_i = (mu^2 - lambda*mag) * phi_i
	// The SAME radial factor multiplies EACH component, so the force points
	// along the field vector and depends only on |Phi|. That leaves the phase
	// directions exactly flat -- the Goldstone modes. At the vacuum
	// mag = mu^2/lambda, vfac = 0, and the state is exactly stationary.
	mag := psi.X*psi.X + psi.Y*psi.Y + psi.Z*psi.Z + psi.W*psi.W
	vfac := musq - lambda*mag

	hf := math32.Vec4(csq*(cov.X+vfac*psi.X), csq*(cov.Y+vfac*psi.Y),
		csq*(cov.Z+vfac*psi.Z), csq*(cov.W+vfac*psi.W))

	// ---- currents, one per spacetime index --------------------------------
	j0 := EWCurrent(psi, d0)
	jx := EWCurrent(psi, dX)
	jy := EWCurrent(psi, dY)
	jz := EWCurrent(psi, dZ)

	// ---- Yang-Mills self-coupling -----------------------------------------
	// Adjoint 3-vectors: for each spacetime index mu, the SU(2) triplet
	// (W^1_mu, W^2_mu, W^3_mu). In this form every eps^{abc} becomes a cross
	// product and the whole self-coupling is a handful of them.
	var ym0, ymx, ymy, ymz math32.Vector3
	if Params[0].YangMills.IsTrue() {
		gw := Params[0].GW
		w0 := math32.Vec3(w10, w20, w30)
		wx := math32.Vec3(w1x, w2x, w3x)
		wy := math32.Vec3(w1y, w2y, w3y)
		wz := math32.Vec3(w1z, w2z, w3z)

		// d_mu W^nu, indexed [derivative direction][component]. The time
		// derivatives are the stored velocities: per step, so divide by c to
		// land in the same 1/cube units as the spatial gradients.
		t0 := math32.Vec3(w10v, w20v, w30v).MulScalar(oc)
		tx := math32.Vec3(w1xv, w2xv, w3xv).MulScalar(oc)
		ty := math32.Vec3(w1yv, w2yv, w3yv).MulScalar(oc)
		tz := math32.Vec3(w1zv, w2zv, w3zv).MulScalar(oc)

		x0 := math32.Vec3(g10.X, g20.X, g30.X)
		y0 := math32.Vec3(g10.Y, g20.Y, g30.Y)
		z0 := math32.Vec3(g10.Z, g20.Z, g30.Z)
		xx := math32.Vec3(g1x.X, g2x.X, g3x.X)
		yx := math32.Vec3(g1x.Y, g2x.Y, g3x.Y)
		zx := math32.Vec3(g1x.Z, g2x.Z, g3x.Z)
		xy := math32.Vec3(g1y.X, g2y.X, g3y.X)
		yy := math32.Vec3(g1y.Y, g2y.Y, g3y.Y)
		zy := math32.Vec3(g1y.Z, g2y.Z, g3y.Z)
		xz := math32.Vec3(g1z.X, g2z.X, g3z.X)
		yz := math32.Vec3(g1z.Y, g2z.Y, g3z.Y)
		zz := math32.Vec3(g1z.Z, g2z.Z, g3z.Z)

		// divergence d.W^a = d_0 W^{a0} + d_j W^{aj}, as an adjoint vector
		dv := t0.Add(xx).Add(yy).Add(zz)

		// [transport] -2g sum_mu (W^mu x d_mu W^nu)  (upper-lower, no signs)
		// [transpose] +g sum_mu (W_mu x d^nu W^mu)   (metric signs, and
		//             d^nu = +d_0 for nu=0 but -d_j for nu=j)
		// [quartic]   -g^2 sum_mu (W_mu x (W^mu x W^nu))
		// [divergence] -g (dv x W^nu)
		ym0 = EWCrossUp(w0, wx, wy, wz, t0, x0, y0, z0).MulScalar(2 * gw)
		ym0 = ym0.Sub(EWCrossLor(w0, wx, wy, wz, t0, tx, ty, tz).MulScalar(gw))
		ym0 = ym0.Sub(EWCrossLor(w0, wx, wy, wz,
			slmath.Cross3(w0, w0), slmath.Cross3(wx, w0),
			slmath.Cross3(wy, w0), slmath.Cross3(wz, w0)).MulScalar(gw * gw))
		ym0 = ym0.Add(slmath.Cross3(dv, w0).MulScalar(gw))

		ymx = EWCrossUp(w0, wx, wy, wz, tx, xx, yx, zx).MulScalar(2 * gw)
		ymx = ymx.Add(EWCrossLor(w0, wx, wy, wz, x0, xx, xy, xz).MulScalar(gw))
		ymx = ymx.Sub(EWCrossLor(w0, wx, wy, wz,
			slmath.Cross3(w0, wx), slmath.Cross3(wx, wx),
			slmath.Cross3(wy, wx), slmath.Cross3(wz, wx)).MulScalar(gw * gw))
		ymx = ymx.Add(slmath.Cross3(dv, wx).MulScalar(gw))

		ymy = EWCrossUp(w0, wx, wy, wz, ty, xy, yy, zy).MulScalar(2 * gw)
		ymy = ymy.Add(EWCrossLor(w0, wx, wy, wz, y0, yx, yy, yz).MulScalar(gw))
		ymy = ymy.Sub(EWCrossLor(w0, wx, wy, wz,
			slmath.Cross3(w0, wy), slmath.Cross3(wx, wy),
			slmath.Cross3(wy, wy), slmath.Cross3(wz, wy)).MulScalar(gw * gw))
		ymy = ymy.Add(slmath.Cross3(dv, wy).MulScalar(gw))

		ymz = EWCrossUp(w0, wx, wy, wz, tz, xz, yz, zz).MulScalar(2 * gw)
		ymz = ymz.Add(EWCrossLor(w0, wx, wy, wz, z0, zx, zy, zz).MulScalar(gw))
		ymz = ymz.Sub(EWCrossLor(w0, wx, wy, wz,
			slmath.Cross3(w0, wz), slmath.Cross3(wx, wz),
			slmath.Cross3(wy, wz), slmath.Cross3(wz, wz)).MulScalar(gw * gw))
		ymz = ymz.Add(slmath.Cross3(dv, wz).MulScalar(gw))
	}

	// ---- gauge field updates: box W = j, box B = j^Y ----------------------
	EWGaugeStep(x, y, z, cur, prv, int32(EWW10s), csq,
		j0.X+ym0.X, jx.X+ymx.X, jy.X+ymy.X, jz.X+ymz.X)
	EWGaugeStep(x, y, z, cur, prv, int32(EWW20s), csq,
		j0.Y+ym0.Y, jx.Y+ymx.Y, jy.Y+ymy.Y, jz.Y+ymz.Y)
	EWGaugeStep(x, y, z, cur, prv, int32(EWW30s), csq,
		j0.Z+ym0.Z, jx.Z+ymx.Z, jy.Z+ymy.Z, jz.Z+ymz.Z)
	EWGaugeStep(x, y, z, cur, prv, int32(EWB0s), csq, j0.W, jx.W, jy.W, jz.W)

	// ---- Higgs update ------------------------------------------------------
	hvCaN := psv.X + hf.X
	hvCbN := psv.Y + hf.Y
	hv0aN := psv.Z + hf.Z
	hv0bN := psv.W + hf.W

	State[z, y, x, EWHsCa, cur] = psi.X + hvCaN
	State[z, y, x, EWHsCb, cur] = psi.Y + hvCbN
	State[z, y, x, EWHs0a, cur] = psi.Z + hv0aN
	State[z, y, x, EWHs0b, cur] = psi.W + hv0bN

	State[z, y, x, EWHvCa, cur] = hvCaN
	State[z, y, x, EWHvCb, cur] = hvCbN
	State[z, y, x, EWHv0a, cur] = hv0aN
	State[z, y, x, EWHv0b, cur] = hv0bN

	State[z, y, x, EWHmag, cur] = mag
	State[z, y, x, EWHV, cur] = -0.5*musq*mag + 0.25*lambda*mag*mag
}

// EWGaugeStep advances one four-potential (the 0,X,Y,Z state variables
// starting at v0, with their four velocities at v0+4) by one leapfrog step of
//
//	d2 A_mu / dt2 = c^2 [ lap(A_mu) + j_mu ]
//
// which is box A_mu = j_mu in Lorenz gauge -- the same equation MaxwellKernel
// solves for the photon, with the electroweak current in place of the
// electromagnetic one. No mass term appears here or anywhere else.
func EWGaugeStep(x, y, z, cur, prv, v0 int32, csq, j0, jx, jy, jz float32) {
	for ki := range 4 {
		k := int32(ki)
		vs := v0 + k
		vv := v0 + 4 + k
		var jc float32
		switch ki {
		case 0:
			jc = j0
		case 1:
			jc = jx
		case 2:
			jc = jy
		default:
			jc = jz
		}
		ps := State[z, y, x, vs, prv]
		vp := State[z, y, x, vv, prv]
		f := csq * (Laplacian19(x, y, z, vs, prv, ps) + jc)
		vc := vp + f
		State[z, y, x, vv, cur] = vc
		State[z, y, x, vs, cur] = ps + vc
	}
}

//gosl:end

func (ss *Sim) ElectroweakConfig() {
	ParamsShouldDisplay = ElectroweakDisplay
	ss.StateVars = EWStatesN
	ss.ViewInit(func(view *View) {
		view.SetVar(EWHs0a, -1)
	})
}

// ElectroweakViewAll configures the View to display Electroweak values
func ElectroweakViewAll(view *View) {
	view.Settings.NPanels = PanelsFour
	view.Settings.Camera = 2
	view.Settings.Height = 0.8
	view.Panels[0].Var = EWHs0a
	view.Panels[1].Var = A0s
	// view.SetCurPrev(Previous, 1)
	view.Panels[2].Var = EWHmag
	// view.SetCurPrev(Previous, 3)
	view.Panels[3].Var = EWHV
	// view.Settings.TrackParticle = 0
}

func (ss *Sim) ElectroweakStats() {
	ss.AddStat(ss.StatStep())
	ss.AddStat(ss.StatSum(EWHmag))
	ss.AddStat(ss.StatSum(EWHV))
	// ss.AddStat(ss.StatParticle(0))
	// ss.AddStat(ss.StatParticle(0))
}

func (ss *Sim) ElectroweakInit() {
	// The vacuum is <Phi> = (0, v/sqrt2)^T, i.e. the NEUTRAL (lower) component
	// holds the VEV, with magnitude v = mu/sqrt(lambda) -- not mu. Putting it
	// in the charged component instead would leave Q = T^3 + Y broken and give
	// the photon a mass.
	ss.Fill(EWHs0a, Both, ss.Params.HiggsV)
	ctx := GetCtx(0)
	ne := int(ctx.EdgesN())
	RunEdgesWrapKernel(ne)
}

// ElectroweakDisplay determines which Parameters fields to display.
var ElectroweakDisplay = []string{"Edges", "Energy", "C", "Hbar", "Mass", "EM", "A0NoWave", "E", "Mu0", "HiggsMu", "HiggsLambda"}
